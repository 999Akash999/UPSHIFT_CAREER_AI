# AI interview integrity policy
INTERVIEW_MAX_WARNINGS=3
INTERVIEW_TAB_SWITCH_COOLDOWN_MS=15000
INTERVIEW_BACKGROUND_NOISE_COOLDOWN_MS=30000
INTERVIEW_EVENT_RATE_WINDOW_MS=60000
INTERVIEW_EVENT_RATE_LIMIT=20
INTERVIEW_INTEGRITY_EVENT_TYPES=TAB_SWITCH,PAGE_HIDDEN,WINDOW_BLUR,BACKGROUND_NOISE

# Multi-language code execution (configure a trusted/self-hosted Piston instance)
# Source code and test input are sent to this server-side runner.
PISTON_URL=
# Optional JSON headers for a protected Piston endpoint, e.g. {"Authorization":"Bearer ..."}
PISTON_AUTH_HEADERS=

# Turso DSA question, test-case, submission, and solved-solution storage
TURSO_URL=
TURSO_SECRET=

# Official UPSHIFT social profiles shown in public and student dashboard footers
INSTAGRAM_URL=https://www.instagram.com/upshiftcareerai999/
LINKEDIN_URL=
X_URL=

# SMTP delivery for support queries (Gmail app password recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
SUPPORT_EMAIL=unshiftcareerai999@gmail.com
