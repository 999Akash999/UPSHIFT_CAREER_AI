<% if (typeof success !== 'undefined' && success.length > 0) { %>
  <div class="flash-alert flash-alert-success alert-dismissible" role="status" aria-live="polite">
    <div class="flash-alert-copy">
      <span aria-hidden="true">✓</span>
      <span><%= success %></span>
    </div>
    <button class="flash-alert-close" type="button" aria-label="Dismiss success message" onclick="this.parentElement.remove()">&times;</button>
  </div>
<% } %>

<% if (typeof error !== 'undefined' && error.length > 0) { %>
  <div class="flash-alert flash-alert-error alert-dismissible" role="alert" aria-live="assertive">
    <div class="flash-alert-copy">
      <span aria-hidden="true">!</span>
      <span><%= error %></span>
    </div>
    <button class="flash-alert-close" type="button" aria-label="Dismiss error message" onclick="this.parentElement.remove()">&times;</button>
  </div>
<% } %>
