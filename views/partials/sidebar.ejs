<% const workspaceHome = currUser && ['student', 'recruiter', 'mentor', 'alumni', 'admin'].includes(currUser.role) ? `/${currUser.role}/dashboard` : '/'; %>
<aside class="sidebar" id="appSidebar" aria-label="Main navigation">
  <a class="sidebar-brand" href="<%= workspaceHome %>">
    <img class="brand-badge brand-logo-image" src="/images/logos/m1.png" alt="" aria-hidden="true">
    <span><strong>UPSHIFT</strong><small><%= currUser ? currUser.role.toUpperCase() : 'STUDENT' %> WORKSPACE</small></span>
  </a>
  <nav class="sidebar-menu">
    <% if (currUser && currUser.role === 'student') { %>
      <a href="/student/dashboard" class="sidebar-link"><span>⌂</span> Dashboard</a>
      <a href="/student/roadmap" class="sidebar-link"><span>↗</span> Learning roadmap</a>
      <a href="/student/daily-tasks" class="sidebar-link"><span>☑</span> Daily tasks</a>
      <a href="/student/leaderboard" class="sidebar-link"><span>🏆</span> Leaderboard</a>
      <a href="/student/code-practice" class="sidebar-link"><span>⌘</span> DSA practice</a>
      <a href="/student/ai-tutor" class="sidebar-link"><span>✦</span> AI tutor</a>
      <a href="/student/resume-builder" class="sidebar-link"><span>▤</span> AI resume builder</a>
      <a href="/student/skill-gap" class="sidebar-link"><span>◉</span> Skill gap</a>
      <a href="/student/employability" class="sidebar-link"><span>◎</span> Employability</a>
      <a href="/student/jobs" class="sidebar-link"><span>⌕</span> Find jobs</a>
      <a href="/student/mentorship" class="sidebar-link"><span>♧</span> Mentorship</a>
      <a href="/student/assessments" class="sidebar-link"><span>✓</span> Assessments</a>
      <a href="/student/projects" class="sidebar-link"><span>⌘</span> Projects</a>
      <a href="/student/applications" class="sidebar-link"><span>↗</span> Applications</a>
      <a href="/student/messages" class="sidebar-link"><span>✉</span> Recruiter messages</a>
      <a href="/student/events" class="sidebar-link"><span>◇</span> Events</a>
      <a href="/student/my-courses" class="sidebar-link"><span>▣</span> My courses</a>
      <a href="/student/profile" class="sidebar-link"><span>◌</span> My profile</a>
    <% } else if (currUser && currUser.role === 'recruiter') { %>
      <a href="/recruiter/dashboard" class="sidebar-link"><span>⌂</span> Dashboard</a>
      <a href="/recruiter/post-job" class="sidebar-link"><span>＋</span> Post a job</a>
      <a href="/recruiter/candidates" class="sidebar-link"><span>⌕</span> Find candidates</a>
      <a href="/recruiter/manage-jobs" class="sidebar-link"><span>▤</span> Manage jobs</a>
      <a href="/recruiter/messages" class="sidebar-link"><span>✉</span> Candidate messages</a>
    <% } else if (currUser && currUser.role === 'mentor') { %>
      <a href="/mentor/dashboard" class="sidebar-link"><span>⌂</span> Dashboard</a>
      <a href="/mentor/slots" class="sidebar-link"><span>◷</span> Availability</a>
      <a href="/mentor/sessions" class="sidebar-link"><span>☆</span> Sessions</a>
    <% } else if (currUser && currUser.role === 'alumni') { %>
      <a href="/alumni/dashboard" class="sidebar-link"><span>⌂</span> Dashboard</a>
      <a href="/alumni/my-events" class="sidebar-link"><span>◇</span> My events</a>
      <a href="/alumni/referrals" class="sidebar-link"><span>↗</span> Referrals</a>
    <% } else if (currUser && currUser.role === 'admin') { %>
      <a href="/admin/dashboard" class="sidebar-link"><span>⌂</span> Dashboard</a>
      <a href="/admin/users" class="sidebar-link"><span>♙</span> Users</a>
      <a href="/admin/companies" class="sidebar-link"><span>▦</span> Companies</a>
      <a href="/admin/audit-logs" class="sidebar-link"><span>≡</span> Audit logs</a>
    <% } %>
    <a href="/resources" class="sidebar-link"><span>▧</span> Free resources</a>
  </nav>
  <div class="sidebar-profile">
    <a href="<%= currUser && currUser.role === 'student' ? '/student/profile' : '/' + (currUser ? currUser.role : 'student') + '/dashboard' %>" class="profile-chip" aria-label="Open profile settings">
      <% if (currUser && currUser.avatar && currUser.avatar !== '/images/avatars/default.png') { %>
        <img class="avatar-image" src="<%= currUser.avatar %>" alt="<%= currUser.name %> profile picture">
      <% } else { %>
        <span class="avatar-fallback"><%= currUser && currUser.name ? currUser.name.charAt(0).toUpperCase() : 'U' %></span>
      <% } %>
      <span class="profile-chip-copy"><strong><%= currUser ? currUser.name : 'Your profile' %></strong><small>View profile</small></span>
      <span class="profile-chevron">›</span>
    </a>
    <a class="sidebar-signout" href="/logout">Sign out</a>
  </div>
</aside>
<button class="sidebar-scrim" id="sidebarScrim" type="button" aria-label="Close menu"></button>
