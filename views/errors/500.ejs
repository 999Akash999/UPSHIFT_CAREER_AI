<% layout('layouts/boilerplate') %>

<div class="status-page" style="min-height: calc(100vh - 180px); display: flex; align-items: center; justify-content: center; padding: 2rem;">
  <div class="status-card" style="background: #0f172a; border: 1px solid #1e3a5f; width: 100%; max-width: 680px; padding: 3.5rem 2.5rem; border-radius: 16px; text-align: center; box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);">
    
    <div style="display: inline-flex; align-items: center; justify-content: center; width: 72px; height: 72px; background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 50%; margin-bottom: 1.5rem;">
      <span style="font-size: 2rem;">💥</span>
    </div>

    <div style="font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; font-weight: 700; color: #f87171; text-transform: uppercase; letter-spacing: 0.15em; margin-bottom: 0.5rem;">
      HTTP 500 &bull; Internal Server Fault
    </div>

    <h2 style="font-size: 2rem; font-weight: 800; color: #ffffff; letter-spacing: -0.02em; margin-bottom: 0.75rem;">
      Engine Runtime Interrupted
    </h2>

    <p style="color: #94a3b8; font-size: 0.95rem; line-height: 1.6; margin-bottom: 2rem;">
      An unexpected internal exception occurred while executing this operation. System administrators have been notified via our telemetry logs.
    </p>

    <!-- Development Mode Stack Trace Dump -->
    <% if (typeof error !== 'undefined' && error && error.stack) { %>
      <div style="text-align: left; background: #070d19; border: 1px solid #334155; border-radius: 8px; padding: 1rem; margin-bottom: 2rem; max-height: 240px; overflow-y: auto;">
        <div style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: #f87171; font-weight: 700; margin-bottom: 0.5rem;">
          DEBUG STACK TRACE (Visible in Development):
        </div>
        <pre style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: #94a3b8; margin: 0; white-space: pre-wrap; word-break: break-word;"><%= error.stack %></pre>
      </div>
    <% } %>

    <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
      <a href="<%= currUser && currUser.role === 'student' ? '/student/dashboard' : '/' %>" style="background: #2563eb; color: #ffffff; padding: 0.75rem 1.6rem; border-radius: 8px; font-weight: 700; font-size: 0.9rem; text-decoration: none; box-shadow: 0 4px 14px rgba(37, 99, 235, 0.4);">
        Retry Dashboard
      </a>
      <a href="mailto:unshiftcareerai999@gmail.com" style="background: #1e293b; border: 1px solid #1e3a5f; color: #ffffff; padding: 0.75rem 1.6rem; border-radius: 8px; font-weight: 700; font-size: 0.9rem; text-decoration: none;">
        Report Fault
      </a>
    </div>

  </div>
</div>
