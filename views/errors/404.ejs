<% layout('layouts/boilerplate') %>

<div class="status-page" style="min-height: calc(100vh - 180px); display: flex; align-items: center; justify-content: center; padding: 2rem;">
  <div class="status-card" style="background: #0f172a; border: 1px solid #1e3a5f; width: 100%; max-width: 540px; padding: 3.5rem 2.5rem; border-radius: 16px; text-align: center; box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);">
    
    <div style="font-family: 'JetBrains Mono', monospace; font-size: 5rem; font-weight: 900; line-height: 1; color: #2563eb; text-shadow: 0 0 30px rgba(37, 99, 235, 0.45); margin-bottom: 1rem;">
      404
    </div>

    <div style="font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; font-weight: 700; color: #60a5fa; text-transform: uppercase; letter-spacing: 0.15em; margin-bottom: 0.5rem;">
      HTTP 404 &bull; Missing Endpoint
    </div>

    <h2 style="font-size: 2rem; font-weight: 800; color: #ffffff; letter-spacing: -0.02em; margin-bottom: 0.75rem;">
      Resource Unresolved
    </h2>

    <p style="color: #94a3b8; font-size: 0.95rem; line-height: 1.6; margin-bottom: 2rem;">
      The path you followed does not map to any active controller, roadmap node, or API service inside UPSHIFT CAREER.
    </p>

    <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
      <a href="/" style="background: #2563eb; color: #ffffff; padding: 0.75rem 1.6rem; border-radius: 8px; font-weight: 700; font-size: 0.9rem; text-decoration: none; box-shadow: 0 4px 14px rgba(37, 99, 235, 0.4);">
        Return to Home Terminal
      </a>
      <a href="/courses" style="background: #1e293b; border: 1px solid #1e3a5f; color: #ffffff; padding: 0.75rem 1.6rem; border-radius: 8px; font-weight: 700; font-size: 0.9rem; text-decoration: none;">
        Browse Courses
      </a>
    </div>

  </div>
</div>
