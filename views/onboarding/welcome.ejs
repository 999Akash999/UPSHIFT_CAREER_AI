<% layout('layouts/boilerplate') %>

<div class="onboarding-page" style="min-height: calc(100vh - 180px); display: flex; align-items: center; justify-content: center; padding: 3rem 1.5rem;">
  <div class="onboarding-card" style="background: #0f172a; border: 1px solid #1e3a5f; width: 100%; max-width: 600px; padding: 3.5rem 2.5rem; border-radius: 16px; text-align: center; box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);">
    
    <!-- Step Badge Indicator -->
    <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(37, 99, 235, 0.12); border: 1px solid rgba(37, 99, 235, 0.3); padding: 0.35rem 0.9rem; border-radius: 30px; color: #60a5fa; font-size: 0.8rem; font-weight: 700; margin-bottom: 1.75rem;">
      <span>●</span> STEP 0 OF 3 &bull; WORKSPACE INITIALIZATION
    </div>

    <div style="width: 68px; height: 68px; background: rgba(37, 99, 235, 0.15); border: 1px solid rgba(37, 99, 235, 0.3); border-radius: 16px; display: inline-flex; align-items: center; justify-content: center; font-size: 2rem; margin-bottom: 1.5rem; color: #60a5fa; box-shadow: 0 0 25px rgba(37, 99, 235, 0.35);">
      🚀
    </div>

    <h2 style="font-size: 2.1rem; font-weight: 800; color: #ffffff; letter-spacing: -0.02em; margin-bottom: 0.8rem;">
      Welcome to UPSHIFT CAREER
    </h2>

    <p style="color: #94a3b8; font-size: 1rem; line-height: 1.6; max-width: 480px; margin: 0 auto 2.5rem;">
      Let's set up your developer persona. In 3 quick steps, our AI will map your baseline skills, diagnose technical gaps, and construct an adaptive learning curriculum.
    </p>

    <!-- Value Checklist -->
    <div style="display: flex; flex-direction: column; gap: 0.85rem; text-align: left; background: #070d19; border: 1px solid #1e3a5f; padding: 1.25rem 1.5rem; border-radius: 10px; margin-bottom: 2.5rem;">
      <div style="display: flex; align-items: center; gap: 0.75rem; font-size: 0.9rem; color: #cbd5e1;">
        <span style="color: #10b981; font-weight: 800;">✓</span>
        <span>Define college background & academic baseline</span>
      </div>
      <div style="display: flex; align-items: center; gap: 0.75rem; font-size: 0.9rem; color: #cbd5e1;">
        <span style="color: #10b981; font-weight: 800;">✓</span>
        <span>Select core programming languages & framework proficiencies</span>
      </div>
      <div style="display: flex; align-items: center; gap: 0.75rem; font-size: 0.9rem; color: #cbd5e1;">
        <span style="color: #10b981; font-weight: 800;">✓</span>
        <span>Set primary industry targets for recruiter cutoffs</span>
      </div>
    </div>

    <a class="onboarding-primary" href="/onboarding/education" style="display: block; width: 100%; background: #2563eb; color: #ffffff; padding: 0.95rem; border-radius: 8px; font-weight: 700; font-size: 1rem; text-decoration: none; box-shadow: 0 4px 14px rgba(37, 99, 235, 0.4); transition: transform 0.2s;">
      Begin Profile Configuration →
    </a>

  </div>
</div>
