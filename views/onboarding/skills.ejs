<% layout('layouts/boilerplate') %>

<div style="min-height: calc(100vh - 180px); display: flex; align-items: center; justify-content: center; padding: 3rem 1.5rem;">
  <div style="background: #0f172a; border: 1px solid #1e3a5f; width: 100%; max-width: 580px; padding: 2.5rem; border-radius: 16px; box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);">

    <!-- Step Progress Header -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
      <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; font-weight: 700; color: #60a5fa; text-transform: uppercase;">Step 2 of 3</span>
      <span style="font-size: 0.8rem; color: #94a3b8; font-weight: 600;">Technical Competencies</span>
    </div>

    <!-- Progress Bar Tracker -->
    <div style="width: 100%; height: 6px; background: #1e293b; border-radius: 3px; margin-bottom: 2rem; overflow: hidden;">
      <div style="width: 66.66%; height: 100%; background: #2563eb; border-radius: 3px;"></div>
    </div>

    <div style="margin-bottom: 1.75rem;">
      <h2 style="font-size: 1.75rem; font-weight: 800; color: #ffffff; margin-bottom: 0.35rem; letter-spacing: -0.02em;">Current Skills</h2>
      <p style="color: #94a3b8; font-size: 0.9rem; margin: 0;">Click tags to select the stacks you have hands-on experience with.</p>
    </div>

    <!-- Clickable Quick-Select Badges -->
    <div style="margin-bottom: 1.5rem;">
      <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #64748b; text-transform: uppercase; margin-bottom: 0.75rem;">Popular Stacks (Click to add)</label>
      <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;" id="presetBadgeContainer">
        <% const presets = ['JavaScript', 'TypeScript', 'Node.js', 'React', 'Python', 'C++', 'Java', 'Docker', 'MongoDB', 'PostgreSQL', 'AWS', 'Git', 'TailwindCSS']; %>
        <% presets.forEach(tag => { %>
          <button
            type="button"
            data-skill-preset="<%= tag %>"
            style="background: #1e293b; border: 1px solid #334155; color: #cbd5e1; font-size: 0.8rem; font-weight: 600; padding: 0.35rem 0.75rem; border-radius: 6px; cursor: pointer; transition: all 0.2s;"
          >
            + <%= tag %>
          </button>
        <% }) %>
      </div>
    </div>

    <form action="/onboarding/skills" method="POST" id="onboardingSkillsForm">
      
      <div style="margin-bottom: 1.75rem;">
        <label for="skillEntry" style="display: block; font-size: 0.85rem; font-weight: 600; color: #cbd5e1; margin-bottom: 0.4rem;">Add skills one by one</label>
        <div style="display:flex;gap:.5rem;">
          <input id="skillEntry" type="text" maxlength="50" autocomplete="off" placeholder="Type a skill, then press Enter" style="min-width:0;flex:1;background:#070d19;border:1px solid #1e3a5f;color:#fff;padding:.75rem 1rem;border-radius:8px;outline:none;font-size:.95rem;">
          <button type="button" id="addSkillButton" style="background:#1e293b;border:1px solid #334155;color:#fff;padding:0 .9rem;border-radius:8px;font-weight:700;cursor:pointer;">Add</button>
        </div>
        <div id="selectedSkillTags" aria-live="polite" style="display:flex;flex-wrap:wrap;gap:.45rem;margin-top:.7rem;"></div>
        <textarea name="skills" id="skillsInputField" hidden><%= student && student.skills ? student.skills.join(', ') : '' %></textarea>
        <p id="skillEntryStatus" role="status" aria-live="polite" style="min-height:1.1rem;margin:.45rem 0 0;color:#fda4af;font-size:.78rem;"></p>
        <span style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 0.3rem;">Our AI will benchmark these against target industry cutoffs to identify your gap areas.</span>
      </div>

      <div style="display: flex; gap: 1rem;">
        <a href="/onboarding/education" style="display: flex; align-items: center; justify-content: center; background: #1e293b; border: 1px solid #1e3a5f; color: #ffffff; padding: 0.85rem 1.4rem; border-radius: 8px; font-weight: 700; font-size: 0.95rem; text-decoration: none;">
          ← Back
        </a>
        <button type="submit" style="flex-grow: 1; background: #2563eb; color: #ffffff; border: none; padding: 0.85rem; border-radius: 8px; font-weight: 700; font-size: 1rem; cursor: pointer; box-shadow: 0 4px 14px rgba(37, 99, 235, 0.4);">
          Save & Define Career Target →
        </button>
      </div>

    </form>

  </div>
</div>

<script src="/js/onboarding-skills.js" defer></script>
