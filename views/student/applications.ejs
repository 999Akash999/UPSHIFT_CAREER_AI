<% layout('layouts/dashboardLayout') %>
<% const interviewList = typeof interviews !== 'undefined' && Array.isArray(interviews) ? interviews : []; const applicationList = typeof applications !== 'undefined' && Array.isArray(applications) ? applications : []; %>
<main class="engagement-page applications-page">
  <header class="engagement-heading"><div><p class="engagement-eyebrow">STUDENT WORKSPACE</p><h1>Applications and interviews</h1><p>Track applications, respond to offers, and confirm interview invitations.</p></div><a class="engagement-secondary" href="/student/messages">Recruiter messages</a></header>

  <section class="engagement-section">
    <div class="engagement-section-heading"><div><h2>Interview invitations</h2><p>Times are shown in India Standard Time.</p></div></div>
    <% if (interviewList.length) { %><div class="engagement-cards">
      <% interviewList.forEach((interview) => { %><article class="engagement-detail-card" data-interview-card="<%= interview._id %>">
        <div class="engagement-detail-top"><div><p class="engagement-eyebrow"><%= interview.job?.title || 'Interview' %></p><h3>Interview with <%= interview.recruiter?.name || 'Recruiter' %></h3></div><span class="candidate-status candidate-status-<%= interview.status %>" data-interview-status><%= interview.status %></span></div>
        <dl class="engagement-detail-grid"><div><dt>Date and time</dt><dd><%= new Date(interview.scheduledAt).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', dateStyle: 'medium', timeStyle: 'short' }) %> IST</dd></div><div><dt>Duration and format</dt><dd><%= interview.durationMinutes %> minutes · <%= interview.format %></dd></div></dl>
        <% if (interview.locationOrLink) { %><p class="engagement-detail-note"><strong><%= interview.format === 'video' ? 'Meeting link' : interview.format === 'onsite' ? 'Location' : 'Contact details' %>:</strong> <% if (interview.format === 'video' && /^https:\/\//i.test(interview.locationOrLink)) { %><a href="<%= interview.locationOrLink %>" target="_blank" rel="noopener noreferrer">Join interview ↗</a><% } else { %><%= interview.locationOrLink %><% } %></p><% } %>
        <% if (interview.notes) { %><p class="engagement-detail-note"><strong>Preparation notes:</strong> <%= interview.notes %></p><% } %>
        <a class="engagement-text-link" href="/student/interviews/<%= interview._id %>/messages">Message recruiter about this interview →</a>
        <% if (interview.status === 'scheduled') { %><div class="engagement-actions"><button class="engagement-primary" type="button" data-respond-interview="<%= interview._id %>" data-status="accepted">Accept invitation</button><button class="engagement-secondary" type="button" data-respond-interview="<%= interview._id %>" data-status="declined">Decline</button></div><% } %>
      </article><% }) %>
    </div><% } else { %><div class="engagement-empty"><h3>No interview invitations yet</h3><p>When a recruiter schedules an interview, the details and response options will appear here.</p></div><% } %>
  </section>

  <section class="engagement-section">
    <div class="engagement-section-heading"><div><h2>My job applications</h2><p>Review your current status and reply when a recruiter sends an offer.</p></div></div>
    <% if (applicationList.length) { %><div class="engagement-cards">
      <% applicationList.forEach((app) => { %><article class="engagement-detail-card" data-application-card="<%= app._id %>">
        <div class="engagement-detail-top"><div><p class="engagement-eyebrow"><%= app.job?.company?.name || 'Company' %></p><h3><%= app.job?.title || 'Software role' %></h3></div><span class="candidate-status candidate-status-<%= app.status %>" data-application-status><%= app.status.replaceAll('-', ' ') %></span></div>
        <dl class="engagement-detail-grid"><div><dt>Applied</dt><dd><%= new Date(app.createdAt).toLocaleDateString('en-IN') %></dd></div><div><dt>Score at application</dt><dd><%= app.employabilityScoreAtApplication %>/100</dd></div></dl>
        <% if (app.status === 'offered') { %><p class="engagement-offer-note">🎉 You have received an offer. Review it with the recruiter and choose your response.</p><div class="engagement-actions"><button class="engagement-primary" type="button" data-respond-offer="<%= app._id %>" data-status="offer-accepted">Accept offer</button><button class="engagement-secondary" type="button" data-respond-offer="<%= app._id %>" data-status="offer-declined">Decline offer</button><a class="engagement-text-link" href="/student/messages">Ask the recruiter a question</a></div><% } %>
        <% if (app.status === 'offer-accepted') { %><p class="engagement-offer-note">Offer accepted. The recruiter has been notified; use Messages to discuss next steps.</p><% } %>
        <% if (app.status === 'offer-declined') { %><p class="engagement-detail-note">Offer declined. You can still message the recruiter if you need to clarify anything.</p><% } %>
        <% if (app.resumeUrl) { %><a class="engagement-text-link" href="<%= app.resumeUrl %>" target="_blank" rel="noopener noreferrer">View submitted resume ↗</a><% } %>
      </article><% }) %>
    </div><% } else { %><div class="engagement-empty"><h3>No job applications yet</h3><p>Find an opening that matches your target role and submit your profile.</p><a class="engagement-primary" href="/student/jobs">Find jobs</a></div><% } %>
  </section>
</main>
<script>
  document.querySelectorAll('[data-respond-interview]').forEach((button) => button.addEventListener('click', async () => {
    const card = button.closest('[data-interview-card]');
    card.querySelectorAll('button').forEach((item) => { item.disabled = true; });
    try {
      const response = await fetch(`/student/interviews/${card.dataset.interviewCard}/respond`, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ status: button.dataset.status }) });
      const result = await response.json();
      if (!response.ok || !result.success) throw new Error(result.error || 'Could not respond to the invitation.');
      card.querySelector('[data-interview-status]').textContent = result.status;
      card.querySelector('[data-interview-status]').className = `candidate-status candidate-status-${result.status}`;
      card.querySelector('.engagement-actions').remove();
    } catch (error) { window.alert(error.message); card.querySelectorAll('button').forEach((item) => { item.disabled = false; }); }
  }));
  document.querySelectorAll('[data-respond-offer]').forEach((button) => button.addEventListener('click', async () => {
    const card = button.closest('[data-application-card]');
    card.querySelectorAll('button').forEach((item) => { item.disabled = true; });
    try {
      const response = await fetch(`/student/applications/${card.dataset.applicationCard}/offer`, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ status: button.dataset.status }) });
      const result = await response.json();
      if (!response.ok || !result.success) throw new Error(result.error || 'Could not respond to the offer.');
      card.querySelector('[data-application-status]').textContent = result.status.replaceAll('-', ' ');
      card.querySelector('[data-application-status]').className = `candidate-status candidate-status-${result.status}`;
      card.querySelector('.engagement-actions').remove();
      const note = document.createElement('p');
      note.className = 'engagement-offer-note';
      note.textContent = result.status === 'offer-accepted' ? 'Offer accepted. The recruiter has been notified; use Messages to discuss next steps.' : 'Offer declined. You can still message the recruiter if you need to clarify anything.';
      card.append(note);
    } catch (error) { window.alert(error.message); card.querySelectorAll('button').forEach((item) => { item.disabled = false; }); }
  }));
</script>
