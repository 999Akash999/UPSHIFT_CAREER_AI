<% layout('layouts/dashboardLayout') %>
<% const tutorConversationError = typeof conversationError !== 'undefined' ? conversationError : ''; %>
<% const tutorMessages = typeof messages !== 'undefined' && Array.isArray(messages) ? messages : []; %>
<% const tutorStudent = typeof student !== 'undefined' ? student : null; %>

<section class="tutor-page">
  <header class="tutor-heading">
    <div><p class="tutor-eyebrow">YOUR PERSONAL STUDY SPACE</p><h1>AI Engineering Tutor</h1><p>Understand the idea, work through an example, then try it yourself.</p></div>
    <div class="tutor-role-pill"><span aria-hidden="true">✦</span><span>Learning for <strong><%= tutorStudent?.targetRole || 'your next role' %></strong></span></div>
  </header>

  <% if (tutorConversationError) { %><p class="tutor-history-notice" role="status"><span aria-hidden="true">ⓘ</span><%= tutorConversationError %></p><% } %>

  <section class="tutor-shell" aria-label="AI tutor conversation">
    <header class="tutor-chat-header">
      <div class="tutor-avatar" aria-hidden="true">✦</div>
      <div><strong>UPSHIFT Tutor</strong><span><i></i> Ready to help · English and Hinglish</span></div>
      <span class="tutor-history-label">Your conversation is saved</span>
    </header>

    <div id="aiTutorFeed" class="tutor-feed" aria-live="polite" aria-relevant="additions text">
      <article class="tutor-message tutor-message-assistant">
        <span class="tutor-message-avatar" aria-hidden="true">✦</span>
        <div class="tutor-message-main"><span class="tutor-message-author">UPSHIFT Tutor</span><div class="tutor-message-content">Hi<%= currUser?.name ? ` ${currUser.name.split(' ')[0]}` : '' %>! Ask about a concept or share a code sample. I’ll explain the idea, walk through an example, and give you a small question to check your understanding.</div></div>
      </article>
      <% tutorMessages.forEach((message) => { %>
        <article class="tutor-message tutor-message-<%= message.role === 'assistant' ? 'assistant' : 'user' %>">
          <span class="tutor-message-avatar" aria-hidden="true"><%= message.role === 'assistant' ? '✦' : (currUser?.name?.charAt(0)?.toUpperCase() || 'Y') %></span>
          <div class="tutor-message-main"><span class="tutor-message-author"><%= message.role === 'assistant' ? 'UPSHIFT Tutor' : 'You' %></span><div class="tutor-message-content"><%= message.content %></div></div>
        </article>
      <% }) %>
    </div>

    <div class="tutor-suggestions" aria-label="Suggested questions">
      <span>Try asking</span>
      <button type="button" data-tutor-suggestion="Explain closures in JavaScript with a small example">Explain a concept</button>
      <button type="button" data-tutor-suggestion="Review this code and help me understand the bug">Understand a code bug</button>
      <button type="button" data-tutor-suggestion="Teach me this topic step by step, then quiz me">Learn step by step</button>
    </div>

    <form id="aiTutorForm" class="tutor-composer">
      <label class="tutor-input-label" for="aiTutorInput">Your question</label>
      <textarea id="aiTutorInput" rows="3" maxlength="6000" placeholder="Ask anything about coding, backend, data science, or your roadmap…" required></textarea>
      <details class="tutor-code-details">
        <summary><span aria-hidden="true">＋</span> Add a code sample <small>Optional · up to 12,000 characters</small></summary>
        <div class="tutor-code-fields">
          <label for="aiTutorCodeLanguage">Language
            <select id="aiTutorCodeLanguage"><option value="javascript">JavaScript</option><option value="typescript">TypeScript</option><option value="python">Python</option><option value="java">Java</option><option value="cpp">C++</option><option value="sql">SQL</option><option value="html">HTML</option><option value="css">CSS</option><option value="text">Other / plain text</option></select>
          </label>
          <label for="aiTutorCode">Paste a focused snippet<textarea id="aiTutorCode" rows="6" maxlength="12000" placeholder="Paste the smallest useful code sample here…"></textarea></label>
        </div>
      </details>
      <div class="tutor-composer-footer">
        <span id="aiTutorStatus" role="status" aria-live="polite">Enter to send · Shift + Enter for a new line</span>
        <span id="aiTutorCharacterCount" class="tutor-character-count">0 / 6,000</span>
        <button id="aiTutorSend" class="tutor-send-button" type="submit"><span>Ask tutor</span><span aria-hidden="true">↑</span></button>
      </div>
    </form>
  </section>
  <p class="tutor-privacy-note">Your questions and tutor replies are saved to your account so you can continue learning later.</p>
</section>
<script src="/js/ai-tutor.js" defer></script>
