<% layout('layouts/dashboardLayout') %>

<section class="projects-page">
  <header class="projects-heading">
    <div>
      <p class="projects-eyebrow">YOUR WORK, IN ONE PLACE</p>
      <h1>My Projects</h1>
      <p>Show what you can build with clear project details, technologies, code, and demos.</p>
    </div>
    <button class="projects-primary-button" type="button" data-project-modal-open>
      <span aria-hidden="true">＋</span> Add a project
    </button>
  </header>

  <section class="projects-overview" aria-label="Project portfolio overview">
    <div class="projects-overview-icon" aria-hidden="true">⌘</div>
    <div><strong><%= projects.length %> <%= projects.length === 1 ? 'project' : 'projects' %></strong><span>in your portfolio</span></div>
    <p>Tip: include the problem you solved, your contribution, and a working demo link.</p>
  </section>

  <% if (projects.length) { %>
    <section class="projects-grid" aria-label="Your projects">
      <% projects.forEach((project) => { %>
        <article class="project-card">
          <div class="project-card-cover">
            <span class="project-card-mark" aria-hidden="true"><%= (project.title || 'P').trim().charAt(0).toUpperCase() %></span>
            <% if (project.isVerified) { %><span class="project-verified"><span aria-hidden="true">✓</span> Verified</span><% } else { %><span class="project-type-label">PROJECT</span><% } %>
          </div>
          <div class="project-card-body">
            <h2><%= project.title %></h2>
            <p class="project-card-description"><%= project.description %></p>
            <div class="project-tech-list" aria-label="Technologies used">
              <% (project.techStack || []).forEach((tech) => { %><span><%= tech %></span><% }) %>
              <% if (!project.techStack?.length) { %><span class="project-tech-empty">Add technologies to your project</span><% } %>
            </div>
            <div class="project-card-footer">
              <% if (project.githubUrl || project.liveDemoUrl) { %>
                <% if (project.githubUrl) { %><a href="<%= project.githubUrl %>" target="_blank" rel="noopener noreferrer"><span aria-hidden="true">⌘</span> View code <span aria-hidden="true">↗</span></a><% } %>
                <% if (project.liveDemoUrl) { %><a href="<%= project.liveDemoUrl %>" target="_blank" rel="noopener noreferrer"><span aria-hidden="true">◉</span> Live demo <span aria-hidden="true">↗</span></a><% } %>
              <% } else { %>
                <span class="project-links-empty">No code or demo link added</span>
              <% } %>
            </div>
          </div>
        </article>
      <% }) %>
      <button class="project-add-card" type="button" data-project-modal-open>
        <span aria-hidden="true">＋</span><strong>Add another project</strong><small>Keep building your portfolio</small>
      </button>
    </section>
  <% } else { %>
    <section class="projects-empty-state">
      <div class="projects-empty-art" aria-hidden="true"><span>⌘</span><i>✦</i></div>
      <p class="projects-eyebrow">YOUR PORTFOLIO STARTS HERE</p>
      <h2>Show the work behind your skills</h2>
      <p>Add a class project, personal build, or team contribution. Include the technologies you used and links where people can explore it.</p>
      <button class="projects-primary-button" type="button" data-project-modal-open>Add your first project <span aria-hidden="true">→</span></button>
    </section>
  <% } %>
</section>

<div class="project-modal-backdrop" id="projectSubmissionModal" role="dialog" aria-modal="true" aria-labelledby="projectModalTitle" aria-describedby="projectModalDescription" hidden>
  <section class="project-modal">
    <header class="project-modal-heading">
      <div><p class="projects-eyebrow">PORTFOLIO BUILDER</p><h2 id="projectModalTitle">Add a project</h2><p id="projectModalDescription">Share enough detail for someone to understand what you made and why it matters.</p></div>
      <button class="project-modal-close" id="closeProjectModal" type="button" aria-label="Close project form">&times;</button>
    </header>
    <form class="project-form" id="projectSubmissionForm" action="/student/projects" method="POST">
      <div class="project-form-grid">
        <label class="project-form-field project-form-field-wide" for="projectTitle">Project title <span>Required</span>
          <input id="projectTitle" type="text" name="title" required minlength="2" maxlength="120" placeholder="e.g. Campus event booking app" autocomplete="off">
        </label>
        <label class="project-form-field project-form-field-wide" for="projectDescription">What did you build? <span>Required</span>
          <textarea id="projectDescription" name="description" rows="4" required minlength="10" maxlength="3000" placeholder="Describe the problem, your approach, and what you contributed."></textarea>
          <small class="project-character-count" id="projectDescriptionCount">0 / 3,000</small>
        </label>
        <label class="project-form-field project-form-field-wide" for="projectTechStack">Technologies <span>Separate with commas</span>
          <input id="projectTechStack" type="text" name="techStack" required maxlength="1500" placeholder="JavaScript, Node.js, MongoDB">
        </label>
        <label class="project-form-field" for="projectGithub">GitHub repository <span>Optional</span>
          <input id="projectGithub" type="url" name="githubUrl" placeholder="https://github.com/you/project" inputmode="url">
        </label>
        <label class="project-form-field" for="projectDemo">Live demo <span>Optional</span>
          <input id="projectDemo" type="url" name="liveDemoUrl" placeholder="https://your-project.com" inputmode="url">
        </label>
      </div>
      <p class="project-form-status" id="projectSubmissionStatus" role="status" aria-live="polite"></p>
      <footer class="project-form-actions">
        <button class="projects-secondary-button" id="cancelProjectModal" type="button">Cancel</button>
        <button class="projects-primary-button" type="submit"><span aria-hidden="true">＋</span> Save project</button>
      </footer>
    </form>
  </section>
</div>

<script src="/js/projects.js" defer></script>
