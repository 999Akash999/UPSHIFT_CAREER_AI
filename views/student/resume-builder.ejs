<% layout('layouts/dashboardLayout') %>

<section class="resume-builder-page">
  <div class="page-heading">
    <div><p class="eyebrow">AI CAREER TOOLS</p><h2>Build your resume</h2><p>Turn your real experience into a clear, ATS-friendly resume. Review every detail before using it.</p></div>
    <span class="ai-tag">✦ Gemini AI</span>
  </div>

  <div class="resume-builder-grid">
    <form class="resume-form panel-card" id="resumeForm">
      <h3>Your details</h3>
      <p class="form-hint">Your saved skills, education, links, and portfolio projects are included automatically. Add factual work experience or extra projects; AI will improve wording without inventing achievements.</p>
      <label>Target role<input name="targetRole" required maxlength="120" value="<%= student.targetRole || '' %>" placeholder="Frontend Developer"></label>
      <label>Phone number<input name="phone" type="tel" maxlength="40" placeholder="+91 98XXXXXXXX"></label>
      <label>Professional summary<textarea name="summary" rows="4" maxlength="5000" placeholder="A short introduction about your background, strengths, and the role you want."><%= student.bio || '' %></textarea></label>
      <label>Skills<input name="skills" maxlength="5000" value="<%= (student.skills || []).join(', ') %>" placeholder="JavaScript, React, Node.js"></label>
      <label>Education<textarea name="education" rows="3" maxlength="5000" placeholder="Degree, college, graduation year"><%= [student.academicDetails?.degree, student.academicDetails?.college, student.academicDetails?.graduationYear].filter(Boolean).join(', ') %></textarea></label>
      <label>Experience<textarea name="experience" rows="5" maxlength="5000" placeholder="Role, company, dates, and what you worked on. Put each role on a new line."></textarea></label>
      <label>Achievements<textarea name="achievements" rows="3" maxlength="5000" placeholder="Awards, coding milestones, or notable accomplishments. Put each on a new line."></textarea></label>
      <label>Projects<textarea name="projects" rows="5" maxlength="5000" placeholder="Project name, technologies, what you built, and any real results."></textarea></label>
      <label>Certifications<textarea name="certifications" rows="2" maxlength="5000" placeholder="List certifications, if you have any."></textarea></label>
      <fieldset class="resume-social-fields">
        <legend>Social links</legend>
        <p class="form-hint">Add the profiles you want recruiters to open from your resume. Leave a field blank to omit it.</p>
        <label>LinkedIn<input name="links.linkedin" type="url" maxlength="500" value="<%= student.socialProfiles?.linkedin || '' %>" placeholder="https://linkedin.com/in/your-name"></label>
        <label>GitHub<input name="links.github" type="url" maxlength="500" value="<%= student.socialProfiles?.github || '' %>" placeholder="https://github.com/your-name"></label>
        <label>LeetCode<input name="links.leetcode" type="url" maxlength="500" value="<%= student.socialProfiles?.leetcode || '' %>" placeholder="https://leetcode.com/u/your-name"></label>
        <label>Portfolio<input name="links.portfolio" type="url" maxlength="500" value="<%= student.socialProfiles?.portfolio || '' %>" placeholder="https://your-portfolio.com"></label>
      </fieldset>
      <label>Job description for keyword coverage <span class="form-hint">Optional. Checked locally against your resume; not sent to AI.</span><textarea name="jobDescription" rows="5" maxlength="10000" placeholder="Paste the job description to see which role skills your resume mentions."></textarea></label>
      <button class="button-primary resume-generate-button" id="generateResumeButton" type="submit"><span>✦</span> Generate my resume</button>
      <p class="resume-status" id="resumeStatus" role="status" aria-live="polite"></p>
    </form>

    <section class="resume-preview-wrap">
      <div class="preview-toolbar"><div><h3>Resume preview</h3><p>Your generated resume will appear here.</p></div><div class="resume-export-actions"><button class="button-secondary is-hidden" id="printResumeButton" type="button" onclick="window.print()">Print</button><button class="button-primary is-hidden" id="downloadResumeButton" type="button">Download PDF</button></div></div>
      <form id="resumeDownloadForm" action="/student/resume-builder/download" method="post" hidden><input type="hidden" name="resume"></form>
      <article class="resume-paper" id="resumePreview">
        <div class="resume-empty"><span>▤</span><strong>Your resume preview</strong><p>Fill in your details and generate a draft. You can then print it or save it as PDF.</p></div>
      </article>
    </section>
  </div>
  <section id="atsAnalysis" class="ats-analysis panel-card" aria-live="polite" hidden></section>
</section>

<script>
  const resumeForm = document.getElementById('resumeForm');
  const resumeStatus = document.getElementById('resumeStatus');
  const resumePreview = document.getElementById('resumePreview');
  const generateResumeButton = document.getElementById('generateResumeButton');
  const printResumeButton = document.getElementById('printResumeButton');
  const downloadResumeButton = document.getElementById('downloadResumeButton');
  const resumeDownloadForm = document.getElementById('resumeDownloadForm');
  const atsAnalysis = document.getElementById('atsAnalysis');
  let currentResume = null;

  function resumeEscape(value) {
    return String(value || '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]);
  }

  function resumeList(items) {
    if (!Array.isArray(items) || !items.length) return '';
    return `<ul>${items.map((item) => `<li>${resumeEscape(item)}</li>`).join('')}</ul>`;
  }

  function groupResumeSkills(skills) {
    const categoryTerms = [
      ['Languages', ['java', 'javascript', 'typescript', 'python', 'c++', 'c#', 'sql']],
      ['Frontend', ['html', 'css', 'react', 'angular', 'vue', 'bootstrap', 'tailwind', 'next.js']],
      ['Backend', ['node.js', 'express', 'django', 'flask', 'spring', 'rest api', 'graphql']],
      ['Databases', ['mongodb', 'mysql', 'postgresql', 'redis', 'sqlite', 'database']],
      ['Tools', ['git', 'github', 'docker', 'postman', 'vscode', 'aws', 'azure', 'linux']],
      ['Core CS', ['data structures', 'algorithms', 'oop', 'operating systems', 'computer networks', 'dbms']],
    ];
    const groups = new Map();
    const add = (category, values) => {
      const existing = groups.get(category) || [];
      values.map((value) => value.trim()).filter(Boolean).forEach((value) => {
        if (!existing.some((item) => item.toLowerCase() === value.toLowerCase())) existing.push(value);
      });
      groups.set(category, existing);
    };
    (Array.isArray(skills) ? skills : []).forEach((raw) => {
      const value = String(raw || '').trim();
      if (!value) return;
      const colon = value.indexOf(':');
      if (colon > 0) { add(value.slice(0, colon).trim(), value.slice(colon + 1).split(/[,;|]/)); return; }
      value.split(/[,;|]/).map((item) => item.trim()).filter(Boolean).forEach((skill) => {
        const lower = skill.toLowerCase();
        const match = categoryTerms.find(([, terms]) => terms.some((term) => lower === term || lower.includes(term)));
        add(match?.[0] || 'Additional Skills', [skill]);
      });
    });
    return [...groups.entries()];
  }

  function renderResume(resume) {
    const experience = Array.isArray(resume.experience) ? resume.experience : [];
    const projects = Array.isArray(resume.projects) ? resume.projects : [];
    const education = Array.isArray(resume.education) ? resume.education : [];
    const certifications = Array.isArray(resume.certifications) ? resume.certifications : [];
    const achievements = Array.isArray(resume.achievements) ? resume.achievements : [];
    const skills = Array.isArray(resume.skills) ? resume.skills : [];
    const skillGroups = groupResumeSkills(skills);
    const links = resume.links || {};
    const socialLabels = { linkedin: 'LinkedIn', github: 'GitHub', leetcode: 'LeetCode', portfolio: 'Portfolio' };
    const socialLinks = Object.entries(socialLabels).filter(([key]) => links[key]).map(([key, label]) => {
      const url = String(links[key]);
      if (!/^https?:\/\//i.test(url)) return '';
      return `<a href="${resumeEscape(url)}" target="_blank" rel="noopener noreferrer" aria-label="Open ${label} profile">${label}<span aria-hidden="true"> ↗</span></a>`;
    }).filter(Boolean).join('');
    resumePreview.innerHTML = `
      <header class="resume-paper-header"><h1>${resumeEscape(resume.name)}</h1>
        <div class="resume-contact">${resume.phone ? `${resumeEscape(resume.phone)} &nbsp; — &nbsp; ` : ''}${resumeEscape(resume.email)}</div>${socialLinks ? `<nav class="resume-social-links" aria-label="Professional profiles">${socialLinks}</nav>` : ''}</header>
      ${resume.summary ? `<section><h2>Professional Summary</h2><p>${resumeEscape(resume.summary)}</p></section>` : ''}
      ${education.length ? `<section><h2>Education</h2>${education.map((item) => `<div class="resume-entry"><h3>${resumeEscape(item.degree || item.school)}${item.year ? `<span>${resumeEscape(item.year)}</span>` : ''}</h3>${item.degree && item.school ? `<p>${resumeEscape(item.school)}</p>` : ''}${item.details ? `<p>${resumeEscape(item.details)}</p>` : ''}</div>`).join('')}</section>` : ''}
      ${skillGroups.length ? `<section><h2>Technical Skills</h2><div class="resume-skill-groups">${skillGroups.map(([category, items]) => `<p><strong>${resumeEscape(category)}:</strong> ${items.map(resumeEscape).join(', ')}</p>`).join('')}</div></section>` : ''}
      ${experience.length ? `<section><h2>Experience</h2>${experience.map((item) => `<div class="resume-entry"><h3>${resumeEscape(item.role)}${item.company ? ` · ${resumeEscape(item.company)}` : ''}${item.duration ? `<span>${resumeEscape(item.duration)}</span>` : ''}</h3>${resumeList(item.bullets)}</div>`).join('')}</section>` : ''}
      ${projects.length ? `<section><h2>Projects</h2>${projects.map((item) => `<div class="resume-entry"><h3>${resumeEscape(item.name)}${item.liveDemoUrl && /^https?:\/\//i.test(item.liveDemoUrl) ? `<a href="${resumeEscape(item.liveDemoUrl)}" target="_blank" rel="noopener noreferrer">Live Demo</a>` : ''}</h3>${item.technologies ? `<p class="resume-date">${resumeEscape(item.technologies)}</p>` : ''}${resumeList(item.bullets)}${item.githubUrl && /^https?:\/\//i.test(item.githubUrl) ? `<a href="${resumeEscape(item.githubUrl)}" target="_blank" rel="noopener noreferrer">Source code</a>` : ''}</div>`).join('')}</section>` : ''}
      ${achievements.length ? `<section><h2>Achievements</h2>${resumeList(achievements)}</section>` : ''}
      ${certifications.length ? `<section><h2>Certifications</h2>${resumeList(certifications)}</section>` : ''}`;
    currentResume = resume;
    printResumeButton.classList.remove('is-hidden');
    downloadResumeButton.classList.remove('is-hidden');
  }

  function renderAtsAnalysis(analysis) {
    atsAnalysis.replaceChildren();
    if (!analysis) { atsAnalysis.hidden = true; return; }
    atsAnalysis.hidden = false;
    const heading = document.createElement('h3'); heading.textContent = 'Resume keyword coverage estimate'; atsAnalysis.append(heading);
    if (analysis.score === null) {
      const note = document.createElement('p'); note.textContent = analysis.note; atsAnalysis.append(note); return;
    }
    const score = document.createElement('strong'); score.className = 'ats-analysis-score'; score.textContent = `${analysis.score}%`; atsAnalysis.append(score);
    const summary = document.createElement('p'); summary.textContent = `${analysis.matchedSkills.length} of ${analysis.matchedSkills.length + analysis.missingSkills.length} recognized role skills appear in the resume.`; atsAnalysis.append(summary);
    [['Matched skills', analysis.matchedSkills], ['Skills to add only if you have them', analysis.missingSkills]].forEach(([label, skills]) => {
      if (!skills.length) return;
      const group = document.createElement('p'); const title = document.createElement('strong'); title.textContent = `${label}: `; group.append(title, document.createTextNode(skills.join(', '))); atsAnalysis.append(group);
    });
    const note = document.createElement('small'); note.textContent = analysis.note; atsAnalysis.append(note);
  }

  resumeForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    resumeStatus.textContent = 'Creating your resume…';
    resumeStatus.className = 'resume-status';
    generateResumeButton.disabled = true;
    generateResumeButton.innerHTML = '<span>◌</span> Creating draft…';
    try {
      const formData = new FormData(resumeForm);
      const payload = Object.fromEntries(formData.entries());
      payload.links = Object.fromEntries(['linkedin', 'github', 'leetcode', 'portfolio'].map((key) => [key, formData.get(`links.${key}`) || '']));
      Object.keys(payload).filter((key) => key.startsWith('links.')).forEach((key) => delete payload[key]);
      const response = await fetch('/student/resume-builder/generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data.error || data.message || `Request failed (${response.status})`);
      renderResume(data.resume);
      renderAtsAnalysis(data.atsAnalysis);
      resumeStatus.textContent = data.fallback ? data.message : 'Draft ready. Review the details, then print or save as PDF.';
      resumeStatus.classList.add(data.fallback ? 'warning' : 'success');
    } catch (error) {
      resumeStatus.textContent = error.message || 'Could not generate the resume. Please try again.';
      resumeStatus.classList.add('error');
    } finally {
      generateResumeButton.disabled = false;
      generateResumeButton.innerHTML = '<span>✦</span> Generate my resume';
    }
  });

  downloadResumeButton.addEventListener('click', async () => {
    if (!currentResume) return;
    resumeDownloadForm.elements.resume.value = JSON.stringify(currentResume);
    resumeDownloadForm.submit();
    resumeStatus.textContent = 'Your PDF download has started.';
    resumeStatus.className = 'resume-status success';
  });
</script>
