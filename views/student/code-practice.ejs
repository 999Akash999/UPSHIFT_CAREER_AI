<script>
(() => {
  const questionData = JSON.parse(document.getElementById('codingQuestionData').textContent);
  const dailyAssignments = JSON.parse(document.getElementById('dailyAssignmentData').textContent);
  const topicCards = [...document.querySelectorAll('.coding-topic-card')];
  const questionRows = [...document.querySelectorAll('.coding-question-row[data-question-id]')];
  const dailyCards = [...document.querySelectorAll('.coding-daily-card')];
  const search = document.getElementById('topicSearch');
  const emptySearch = document.getElementById('noTopics');
  const selectedName = document.getElementById('selectedTopicName');
  const emptyTopic = document.getElementById('codingTopicEmpty');
  const editor = document.getElementById('solutionEditor');
  const testcaseView = document.getElementById('codingTestcaseView');
  const resultView = document.getElementById('codingResultView');
  const runButton = document.getElementById('runCode');
  const submitButton = document.getElementById('submitCode');
  const languageSelect = document.getElementById('codingLanguage');
  const testcaseTab = document.getElementById('testcaseTab');
  const resultTab = document.getElementById('resultTab');
  const runnerConfigured = <%= runnerConfigured ? 'true' : 'false' %>;
  const fileExtension = { javascript: 'js', python: 'py', java: 'java', c: 'c', cpp: 'cpp' };
  const topicNameById = new Map(topicCards.map((card) => [card.dataset.topicId, card.querySelector('strong').textContent]));
  let activeQuestion = null;

  const showOutputTab = (tab) => {
    const showingResult = tab === 'result';
    testcaseView.hidden = showingResult;
    resultView.hidden = !showingResult;
    testcaseTab.classList.toggle('is-active', !showingResult);
    resultTab.classList.toggle('is-active', showingResult);
    testcaseTab.setAttribute('aria-selected', String(!showingResult));
    resultTab.setAttribute('aria-selected', String(showingResult));
  };

  const showSamples = (question) => {
    testcaseView.replaceChildren();
    (question.sampleTestCases || []).forEach((testCase, index) => {
      const item = document.createElement('article'); item.className = 'coding-sample-case';
      const heading = document.createElement('strong'); heading.textContent = `Case ${index + 1}`;
      const inputLabel = document.createElement('small'); inputLabel.textContent = 'Input';
      const input = document.createElement('pre'); input.textContent = testCase.input;
      const outputLabel = document.createElement('small'); outputLabel.textContent = 'Expected output';
      const output = document.createElement('pre'); output.textContent = testCase.expectedOutput;
      item.append(heading, inputLabel, input, outputLabel, output); testcaseView.append(item);
    });
  };

  const showQuestion = (questionId) => {
    const question = questionData.find((item) => item.id === questionId);
    if (!question) return;
    activeQuestion = question;
    dailyCards.forEach((card) => card.classList.toggle('is-selected', card.dataset.questionId === questionId));
    questionRows.forEach((row) => {
      const selected = row.dataset.questionId === questionId;
      row.classList.toggle('is-selected', selected);
      row.setAttribute('aria-pressed', String(selected));
    });
    document.getElementById('problemDifficulty').textContent = question.difficulty;
    document.getElementById('problemTopic').textContent = topicNameById.get(question.topicId) || '';
    document.getElementById('problemSequence').textContent = `Question ${question.questionNumber}`;
    document.getElementById('problemTitle').textContent = question.title;
    document.getElementById('problemTestCaseCount').textContent = question.testCaseCount || 10;
    document.getElementById('toolbarTitle').textContent = question.title;
    document.getElementById('toolbarTopic').textContent = (topicNameById.get(question.topicId) || '').toUpperCase();
    document.getElementById('problemPrompt').textContent = question.prompt;
    const approachSection = document.getElementById('problemApproachSection');
    approachSection.hidden = !question.explanation;
    document.getElementById('problemExplanation').textContent = question.explanation || '';
    document.getElementById('problemComplexity').textContent = question.complexity || '';
    const constraints = document.getElementById('problemConstraints'); constraints.replaceChildren();
    question.constraints.forEach((item) => { const li = document.createElement('li'); li.textContent = item; constraints.append(li); });
    const examples = document.getElementById('problemExamples'); examples.replaceChildren();
    question.examples.forEach((item, index) => {
      const block = document.createElement('pre'); block.className = 'coding-example';
      block.textContent = `Example ${index + 1}\nInput: ${JSON.stringify(item.input)}\nOutput: ${JSON.stringify(item.output)}`;
      examples.append(block);
    });
    showSamples(question);
    if (question.savedSolution?.language && question.starterCode[question.savedSolution.language]) {
      languageSelect.value = question.savedSolution.language;
    }
    const savedCode = question.savedSolution?.language === languageSelect.value ? question.savedSolution.sourceCode : null;
    editor.value = savedCode || question.starterCode[languageSelect.value] || '';
    document.getElementById('solutionFilename').textContent = `Solution.${fileExtension[languageSelect.value]}`;
    resultView.replaceChildren();
    const empty = document.createElement('span'); empty.className = 'coding-output-empty';
    empty.textContent = runnerConfigured ? 'Run your code to see the result here.' : 'Set PISTON_URL on the server to enable code execution.';
    resultView.append(empty); showOutputTab('testcase');
    document.getElementById('testSummary').textContent = runnerConfigured ? 'Ready to run' : 'Piston runner needs setup';
    document.getElementById('editorLineInfo').textContent = 'Ln 1, Col 1';
    runButton.disabled = !runnerConfigured; submitButton.disabled = !runnerConfigured;
  };

  const chooseTopic = (card) => {
    topicCards.forEach((item) => { item.classList.remove('is-selected'); item.setAttribute('aria-pressed', 'false'); });
    card.classList.add('is-selected'); card.setAttribute('aria-pressed', 'true');
    const topicId = card.dataset.topicId;
    selectedName.textContent = card.querySelector('strong').textContent;
    const matchingRows = questionRows.filter((row) => row.dataset.topicId === topicId);
    questionRows.forEach((row) => { row.hidden = row.dataset.topicId !== topicId; });
    emptyTopic.hidden = matchingRows.length > 0;
    if (matchingRows.length) {
      editor.readOnly = false; runButton.disabled = !runnerConfigured;
      showQuestion(matchingRows[0].dataset.questionId);
    } else {
      questionRows.forEach((row) => { row.classList.remove('is-selected'); row.setAttribute('aria-pressed', 'false'); });
      dailyCards.forEach((dailyCard) => dailyCard.classList.remove('is-selected'));
      document.getElementById('problemTitle').textContent = 'No question selected';
      document.getElementById('problemPrompt').textContent = 'Questions for this topic will appear here when they are added.';
      document.getElementById('problemDifficulty').textContent = '';
      document.getElementById('problemTopic').textContent = card.querySelector('strong').textContent;
      document.getElementById('problemSequence').textContent = '';
      document.getElementById('problemApproachSection').hidden = true;
      document.getElementById('problemConstraints').replaceChildren();
      document.getElementById('problemExamples').replaceChildren();
      activeQuestion = null;
      editor.value = ''; editor.readOnly = true; runButton.disabled = true; submitButton.disabled = true;
      testcaseView.textContent = 'Select a question to start coding.';
    }
  };

  topicCards.forEach((card) => card.addEventListener('click', () => {
    chooseTopic(card);
    document.getElementById('codingQuestionList').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }));
  questionRows.forEach((row) => row.addEventListener('click', () => {
    showQuestion(row.dataset.questionId);
    document.querySelector('.coding-workspace-preview').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }));
  languageSelect.addEventListener('change', () => {
    if (!activeQuestion) return;
    editor.value = activeQuestion.savedSolution?.language === languageSelect.value
      ? activeQuestion.savedSolution.sourceCode
      : activeQuestion.starterCode[languageSelect.value] || '';
    document.getElementById('solutionFilename').textContent = `Solution.${fileExtension[languageSelect.value]}`;
    resultView.replaceChildren();
    const empty = document.createElement('span'); empty.className = 'coding-output-empty'; empty.textContent = 'Starter code changed. Run it to see the result.'; resultView.append(empty);
    document.getElementById('testSummary').textContent = 'Starter code loaded'; showOutputTab('testcase');
  });
  const updateCursorPosition = () => {
    const before = editor.value.slice(0, editor.selectionStart);
    const lines = before.split('\n');
    document.getElementById('editorLineInfo').textContent = `Ln ${lines.length}, Col ${lines[lines.length - 1].length + 1}`;
  };
  editor.addEventListener('keyup', updateCursorPosition);
  editor.addEventListener('click', updateCursorPosition);
  editor.addEventListener('keydown', (event) => {
    if (event.key === 'Tab') {
      event.preventDefault();
      const start = editor.selectionStart; const end = editor.selectionEnd;
      editor.setRangeText('    ', start, end, 'end'); updateCursorPosition();
    } else if (event.key === 'Enter' && (event.ctrlKey || event.metaKey)) {
      event.preventDefault(); executeSubmission(event.shiftKey ? 'submit' : 'run');
    }
  });
  testcaseTab.addEventListener('click', () => showOutputTab('testcase'));
  resultTab.addEventListener('click', () => showOutputTab('result'));
  search.addEventListener('input', () => {
    const query = search.value.trim().toLowerCase();
    let visibleCount = 0;
    topicCards.forEach((card) => {
      const matches = card.dataset.search.includes(query);
      card.hidden = !matches;
      if (matches) visibleCount += 1;
    });
    emptySearch.hidden = visibleCount > 0;
  });

  const executeSubmission = async (action) => {
    if (!activeQuestion || !runnerConfigured) return;
    const button = action === 'run' ? runButton : submitButton;
    runButton.disabled = true; submitButton.disabled = true;
    button.textContent = action === 'run' ? 'Running…' : 'Submitting…';
    document.getElementById('testSummary').textContent = action === 'run' ? 'Running examples…' : 'Checking all test cases…';
    resultView.replaceChildren();
    const pending = document.createElement('span'); pending.className = 'coding-output-empty';
    pending.textContent = action === 'run' ? 'Compiling and running sample cases…' : 'Compiling and checking sample + hidden cases…';
    resultView.append(pending); showOutputTab('result');
    fetch('/student/code-practice/run', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ questionId: activeQuestion.id, language: languageSelect.value, sourceCode: editor.value, action }),
    }).then(async (response) => {
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data.error || 'Could not run this submission.');
      const passed = data.results.filter((item) => item.passed).length;
      const summary = document.createElement('strong'); summary.className = `coding-test-summary ${data.accepted ? 'is-pass' : 'is-fail'}`;
      summary.textContent = data.accepted ? 'Accepted · All test cases passed' : `${passed} / ${data.results.length} ${action === 'run' ? 'sample cases' : 'test cases'} passed`;
      resultView.replaceChildren(summary);
      data.results.forEach((item) => {
        const row = document.createElement('div'); row.className = `coding-test-row ${item.passed ? 'is-pass' : 'is-fail'}`;
        const label = document.createElement('strong'); label.textContent = `Case ${item.index} · ${item.status}`; row.append(label);
        if (item.message || item.actualOutput) { const details = document.createElement('small'); details.textContent = item.message || `Output: ${item.actualOutput}`; row.append(details); }
        resultView.append(row);
      });
      if (data.accepted && data.streak) {
        const streak = document.createElement('small'); streak.className = 'coding-local-note';
        streak.textContent = `DSA streak updated: ${data.streak.current} day${data.streak.current === 1 ? '' : 's'} · best ${data.streak.best}`;
        resultView.append(streak);
      }
      if (data.accepted) {
        activeQuestion.isSolved = true;
        activeQuestion.savedSolution = { language: languageSelect.value, sourceCode: editor.value };
        const selectedQuestionRow = document.querySelector('.coding-question-row.is-selected');
        if (selectedQuestionRow && !selectedQuestionRow.querySelector('.coding-solved-badge')) {
          const solvedBadge = document.createElement('span'); solvedBadge.className = 'coding-solved-badge'; solvedBadge.textContent = '✓ Solved'; selectedQuestionRow.append(solvedBadge);
        }
        const assignment = dailyAssignments.find((item) => item.questionId === activeQuestion.id);
        const dailyCard = dailyCards.find((item) => item.dataset.questionId === activeQuestion.id);
        if (assignment && dailyCard && data.dailyProgress) {
          assignment.isCompleted = true;
          dailyCard.classList.add('is-complete');
          dailyCard.querySelector('small').textContent = '✓ Completed';
          document.getElementById('dailyProgress').textContent = `${data.dailyProgress.completed} / ${data.dailyProgress.total} complete`;
        }
      }
      document.getElementById('testSummary').textContent = data.accepted ? 'Accepted' : `${passed} / ${data.results.length} cases passed`;
    }).catch((error) => {
      resultView.replaceChildren();
      const message = document.createElement('span'); message.className = 'coding-output-empty is-error'; message.textContent = error.message || 'The code runner is unavailable. Please try again.';
      resultView.append(message); document.getElementById('testSummary').textContent = 'Run failed';
    }).finally(() => {
      runButton.disabled = !runnerConfigured || !activeQuestion;
      submitButton.disabled = !runnerConfigured || !activeQuestion;
      runButton.innerHTML = '<span aria-hidden="true">▶</span> Run'; submitButton.textContent = 'Submit';
    });
  };
  runButton.addEventListener('click', () => executeSubmission('run'));
  submitButton.addEventListener('click', () => executeSubmission('submit'));
  dailyCards.forEach((card) => card.addEventListener('click', () => {
    const question = questionData.find((item) => item.id === card.dataset.questionId);
    if (!question) return;
    const topicCard = topicCards.find((item) => item.dataset.topicId === question.topicId);
    if (topicCard) chooseTopic(topicCard);
    showQuestion(question.id);
    document.querySelector('.coding-workspace-preview').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }));
  const firstAvailableTopic = topicCards.find((card) => questionRows.some((row) => row.dataset.topicId === card.dataset.topicId)) || topicCards[0];
  if (firstAvailableTopic) chooseTopic(firstAvailableTopic);
})();
</script>
