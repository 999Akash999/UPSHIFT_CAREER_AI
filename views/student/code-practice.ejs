<% layout('layouts/dashboardLayout') %>

<main class="coding-page">
  <header class="coding-hero">
    <div>
      <p class="coding-eyebrow">INTERVIEW PREPARATION</p>
      <h1>DSA Practice</h1>
      <p>Practice these questions, clear your concepts, and get placed at FAANG/MAANG.</p>
    </div>
      <span class="coding-language-pill">Java · C++ · C · JavaScript · Python</span>
  </header>

  <section class="coding-progress" aria-label="Question bank progress">
    <div class="coding-progress-icon" aria-hidden="true">&lt;/&gt;</div>
    <div class="coding-progress-copy"><strong><%= solvedQuestionCount %> <span> / <%= targetQuestionCount %></span></strong><small>questions solved · <%= questionCount %> questions available</small></div>
    <div class="coding-progress-track" aria-label="<%= Math.round(solvedQuestionCount / targetQuestionCount * 100) %> percent complete"><span style="width:<%= Math.max(1, Math.round(solvedQuestionCount / targetQuestionCount * 100)) %>%"></span></div>
    <p>Your solved questions and accepted solutions are saved to your practice profile.</p>
  </section>

  <section class="coding-catalog" aria-labelledby="topicHeading">
    <div class="coding-section-heading">
      <div><p class="coding-eyebrow">BUILD YOUR DSA FOUNDATION</p><h2 id="topicHeading">Choose a topic</h2></div>
      <label class="coding-search"><span aria-hidden="true">⌕</span><input id="topicSearch" type="search" placeholder="Search topics" aria-label="Search topics"></label>
    </div>

    <div class="coding-topic-grid" id="topicGrid">
      <% topics.forEach((topic, index) => { %>
        <button class="coding-topic-card <%= index === 0 ? 'is-selected' : '' %>" type="button" data-topic-id="<%= topic.id %>" data-search="<%= `${topic.name} ${topic.description}`.toLowerCase() %>" aria-pressed="<%= index === 0 ? 'true' : 'false' %>">
          <span class="coding-topic-number"><%= String(index + 1).padStart(2, '0') %></span>
          <span class="coding-topic-copy"><strong><%= topic.name %></strong><small><%= topic.description %></small></span>
          <span class="coding-topic-count"><%= topic.questionCount %></span>
        </button>
      <% }) %>
    </div>
    <p class="coding-no-topics" id="noTopics" hidden>No topics match your search.</p>
  </section>

  <section class="coding-questions" aria-live="polite">
    <div><p class="coding-eyebrow">SELECTED TOPIC</p><h2 id="selectedTopicName"><%= topics[0].name %></h2></div>
    <div class="coding-question-list" id="codingQuestionList">
      <% questions.forEach((question, index) => { %>
        <button type="button" class="coding-question-row <%= index === 0 ? 'is-selected' : '' %>" data-question-id="<%= question.id %>" data-topic-id="<%= question.topicId %>" aria-pressed="<%= index === 0 ? 'true' : 'false' %>">
          <span class="coding-question-number"><%= question.questionNumber %></span><span class="coding-question-title"><strong><%= question.title %></strong><small><%= topics.find(topic => topic.id === question.topicId)?.name %></small></span><% if (question.isSolved) { %><span class="coding-solved-badge">✓ Solved</span><% } %><span class="coding-difficulty <%= question.difficulty.toLowerCase() %>"><%= question.difficulty %></span>
        </button>
      <% }) %>
      <div class="coding-topic-empty" id="codingTopicEmpty" hidden>No questions in this topic yet. More will be added as the question bank grows.</div>
    </div>
  </section>

  <section class="coding-daily-strip" aria-label="Today's assigned questions">
    <div class="coding-daily-heading"><a href="/student/dashboard" aria-label="Back to dashboard">← Dashboard</a><div><strong>Today’s DSA set</strong><small>Complete all 3 questions to keep today’s practice on track.</small></div><span id="dailyProgress"><%= dailyCompletedCount %> / 3 complete</span></div>
    <div class="coding-daily-list" id="dailyAssignments">
      <% dailyAssignments.forEach((assignment) => { %>
        <button type="button" class="coding-daily-card <%= assignment.isCompleted ? 'is-complete' : '' %>" data-question-id="<%= assignment.questionId %>"><span><%= String(assignment.slot).padStart(2, '0') %></span><strong><%= assignment.title %></strong><small><%= assignment.isCompleted ? '✓ Completed' : assignment.difficulty %></small></button>
      <% }) %>
    </div>
  </section>
  <section class="coding-workspace-preview" aria-label="Coding workspace">
    <div class="coding-workspace-toolbar">
      <div class="coding-toolbar-question"><span aria-hidden="true">‹</span><div><small>DSA PRACTICE / <span id="toolbarTopic">ARRAYS &amp; HASHING</span></small><strong id="toolbarTitle">Find two values that reach the goal</strong></div></div>
      <div class="coding-toolbar-actions"><button type="button" id="runCode" class="coding-run-button" <%= runnerConfigured ? '' : 'disabled' %>><span aria-hidden="true">▶</span> Run</button><button type="button" id="submitCode" class="coding-submit-button" <%= runnerConfigured ? '' : 'disabled' %>>Submit</button></div>
    </div>
    <div class="coding-workspace-grid">
      <article class="coding-problem-placeholder" id="codingProblem" aria-labelledby="problemTitle">
        <nav class="coding-problem-tabs" aria-label="Problem details"><button type="button" class="is-active">Description</button><span>·</span><span class="coding-problem-tab-meta">UPSHIFT DSA</span></nav>
        <div class="coding-problem-scroll"><div class="coding-problem-meta"><span id="problemSequence">Question 1</span><span id="problemDifficulty">Easy</span><span id="problemTopic">Arrays &amp; Hashing</span></div><h1 id="problemTitle">Find two values that reach the goal</h1><p id="problemPrompt"></p><h2>Constraints</h2><ul id="problemConstraints"></ul><h2>Examples</h2><div id="problemExamples"></div><section id="problemApproachSection" hidden><h2>Approach</h2><p id="problemExplanation"></p><p id="problemComplexity" class="coding-complexity"></p></section><p class="coding-hidden-test-note">Run checks sample cases. Submit checks all <strong id="problemTestCaseCount">10</strong> test cases (including hidden ones); passing every case updates your DSA streak.</p></div>
      </article>
      <div class="coding-editor-column">
        <article class="coding-editor-placeholder"><div class="coding-editor-top"><div class="coding-editor-title"><span class="coding-code-mark">{ }</span><strong>Code</strong></div><label class="coding-language-select-label" for="codingLanguage"><select id="codingLanguage" aria-label="Select coding language"><option value="javascript">JavaScript (Node.js)</option><option value="cpp">C++</option><option value="c">C</option><option value="java">Java</option><option value="python">Python 3</option></select></label></div><div class="coding-editor-tools"><span id="solutionFilename">Solution.js</span><span>UPSHIFT editor</span></div><textarea id="solutionEditor" aria-label="Code editor" spellcheck="false" autocapitalize="off" autocomplete="off"></textarea><div class="coding-editor-footer"><span id="testSummary"><%= runnerConfigured ? 'Ready to run' : 'Piston runner needs setup' %></span><span id="editorLineInfo">Ln 1, Col 1</span></div></article>
        <section class="coding-output-panel" aria-label="Test cases and results"><div class="coding-output-tabs"><button id="testcaseTab" type="button" class="is-active" aria-selected="true">☑ Testcase</button><button id="resultTab" type="button" aria-selected="false">›_ Test Result</button></div><div id="codingTestResults" class="coding-test-results" role="status" aria-live="polite"><div id="codingTestcaseView" class="coding-testcase-view">Choose an example case to inspect its input and expected output.</div><div id="codingResultView" class="coding-result-view" hidden><span class="coding-output-empty">Run your code to see the result here.</span></div></div></section>
      </div>
    </div>
  </section>
</main>

<script type="application/json" id="codingQuestionData"><%- questionsJson %></script>
<script type="application/json" id="dailyAssignmentData"><%- dailyAssignmentsJson %></script>

