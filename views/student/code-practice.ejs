s{display:block;overflow:auto;min-height:0;padding:.75rem .9rem;border:0;color:#81788e;font-size:.72rem}.coding-testcase-view,.coding-result-view{display:grid;gap:.6rem}.coding-sample-case{display:grid;grid-template-columns:1fr 1fr;gap:.35rem .8rem;padding:.65rem .75rem;border:1px solid #eee9f3;border-radius:9px;background:#fff}.coding-sample-case strong{grid-column:1/-1;color:#4b4058;font-size:.69rem}.coding-sample-case small{color:#93889e;font-size:.6rem;font-weight:800}.coding-sample-case pre{overflow:auto;margin:0;padding:.5rem .6rem;border-radius:6px;background:#f7f5f9;color:#51475d;font:11px/1.5 ui-monospace,monospace;white-space:pre-wrap}.coding-output-empty{display:grid;min-height:140px;place-items:center;color:#a198aa;font-size:.72rem;text-align:center}.coding-output-empty.is-error{color:#a24752}.coding-test-summary{display:block;margin-bottom:.35rem;color:#423750;font-size:.76rem}.coding-test-summary.is-pass{color:#18704f}.coding-test-summary.is-fail{color:#a24752}.coding-test-row{display:grid;grid-template-columns:1fr;gap:.25rem;padding:.55rem .65rem;border-radius:8px;font-size:.68rem}.coding-test-row small{color:inherit;opacity:.8}.coding-local-note{display:block;padding:.55rem .65rem;border-radius:8px;background:#f0f8f3;color:#18704f;font-size:.68rem}
