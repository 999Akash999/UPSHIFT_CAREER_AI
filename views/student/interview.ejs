<% layout('layouts/dashboardLayout') %>
<main class="mock-interview-page">
  <header class="mock-interview-heading">
    <div><p class="mock-eyebrow">PRACTICE ROOM · AI COACH</p><h1>Mock interview</h1><p>Practice role-specific questions, get clear feedback, and build confidence one answer at a time.</p></div>
    <div class="mock-session-length"><span aria-hidden="true">◷</span><div><strong>10 questions</strong><small>Usually 15–25 minutes</small></div></div>
  </header>

  <section class="mock-interview-shell">
    <section class="mock-setup" id="interviewSetup">
      <div class="mock-setup-copy"><p class="mock-eyebrow">BEFORE YOU BEGIN</p><h2>Set up your interview room</h2><p>Camera access and sharing your <strong>entire monitor</strong> are required before questions begin. This helps you practise in a focused interview setting.</p></div>
      <div class="mock-requirements">
        <article><span class="mock-requirement-icon">◉</span><div><strong>Camera required</strong><small>Allow camera access and keep it on during the session.</small></div></article>
        <article><span class="mock-requirement-icon">▣</span><div><strong>Entire screen required</strong><small>Choose your full monitor in the browser prompt. Window or tab sharing will not start the interview.</small></div></article>
      </div>
      <div class="mock-disclosure"><span aria-hidden="true">ⓘ</span><p>Your camera and screen previews stay in this browser. Video and screen content are not uploaded or recorded; interview answers and monitoring warnings are saved with your practice result.</p></div>
      <div class="mock-form-grid">
        <label for="roleType">Interview role<input id="roleType" value="<%= targetRole %>" maxlength="100" placeholder="e.g. Backend Developer"></label>
        <label for="interviewLanguage">Interview language<select id="interviewLanguage"><option value="en-IN">English</option><option value="hi-IN">Hindi / Hinglish</option></select></label>
      </div>
      <label class="mock-consent"><input id="monitoringConsent" type="checkbox"><span>I understand that camera and full-screen sharing must remain active during this practice interview.</span></label>
      <button class="mock-button mock-button-primary mock-start-button" id="startInterviewButton" type="button" disabled><span aria-hidden="true">↗</span> Enable devices and start</button>
      <p class="mock-status" id="setupStatus" role="status" aria-live="polite">Allow access in your browser. Choose “Entire Screen” when the screen-sharing prompt appears.</p>
    </section>

    <section class="mock-room" id="interviewRoom" hidden>
      <div class="mock-room-topbar"><div><p class="mock-eyebrow">LIVE PRACTICE SESSION</p><h2 id="roomRoleTitle">Interview practice</h2></div><span class="mock-live-indicator"><i></i> In progress</span></div>
      <div class="mock-device-status" id="deviceStatusBar"><span class="mock-device-pill" id="cameraDevicePill">Camera connected</span><span class="mock-device-pill" id="screenDevicePill">Entire monitor shared</span><span class="mock-status-copy" id="deviceStatus" role="status">Your video stays in this browser and is not uploaded.</span></div>
      <div class="mock-video-grid">
        <div class="mock-video-card"><div class="mock-video-wrap"><video id="cameraVideo" autoplay muted playsinline></video><div class="mock-video-placeholder" id="cameraPlaceholder"><span>◉</span><strong>Camera preview</strong></div><span class="mock-video-label">YOU · CAMERA</span></div></div>
        <div class="mock-video-card"><div class="mock-video-wrap"><video id="screenVideo" autoplay muted playsinline></video><div class="mock-video-placeholder" id="screenPlaceholder"><span>▣</span><strong>Shared monitor preview</strong></div><span class="mock-video-label">YOUR ENTIRE SCREEN</span></div></div>
      </div>

      <section class="mock-device-gate" id="deviceRecovery" hidden><div><strong>Interview paused</strong><p id="deviceRecoveryText">Restore camera and entire-screen sharing before answering.</p></div><button class="mock-button mock-button-secondary" id="restoreDevicesButton" type="button">Restore devices</button></section>
      <section class="mock-warning-panel" id="warningPanel" aria-live="polite" hidden><div class="mock-warning-heading"><span>!</span><div><strong id="warningTitle">Interview room warning</strong><p id="warningCountText">Please keep the interview tab visible.</p></div></div><ul id="warningList"></ul></section>

      <div class="mock-question-progress"><div><span>QUESTION</span><strong id="questionProgress">1 <small>/ 10</small></strong></div><div class="mock-progress-track"><span id="questionProgressFill"></span></div><span id="interviewStatus" role="status" aria-live="polite">Listen to the question, then share your answer.</span></div>
      <section class="mock-question-card"><div class="mock-question-card-top"><span class="mock-ai-avatar">✦</span><div><p class="mock-eyebrow">AI INTERVIEWER</p><strong>Your next question</strong></div></div><p id="mockQuestion"></p><button class="mock-repeat-button" id="repeatQuestionButton" type="button">▶ <span>Repeat question</span></button></section>
      <label class="mock-answer-label" for="mockAnswerText">Your answer <span>Be specific. Explain your decisions and results.</span></label>
      <textarea id="mockAnswerText" rows="6" maxlength="5000" placeholder="Type your answer, or use voice input…" disabled></textarea>
      <div class="mock-answer-actions"><button class="mock-button mock-button-secondary" id="micButton" type="button" disabled>🎙 Answer with microphone</button><span>Your answer is sent to the AI interviewer for feedback.</span><button class="mock-button mock-button-primary" id="submitAnswerButton" type="button" disabled>Submit answer <span aria-hidden="true">→</span></button></div>
      <section id="mockFeedbackBox" class="mock-feedback" aria-live="polite" hidden></section>
      <section id="finalScoreBox" class="mock-final-score" aria-live="polite" hidden></section>
    </section>
  </section>
</main>
<script src="/js/interview.js" defer></script>
