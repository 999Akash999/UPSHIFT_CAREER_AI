<% layout('layouts/dashboardLayout') %>

<section class="daily-workspace">
  <header class="daily-heading"><div><p class="eyebrow">SMALL STEPS, REAL PROGRESS</p><h1>Today’s tasks</h1><p>Complete a focused task to grow your streak and employability score.</p></div><a class="button-secondary" href="/student/roadmap">Open roadmap →</a></header>
  <% if (tasksError) { %><p role="status" style="margin:0 0 1rem;padding:.8rem 1rem;border:1px solid #f0c7ce;border-radius:10px;background:#fff5f6;color:#9d3f52;font-size:.82rem;"><%= tasksError %></p><% } %>
  <div class="daily-summary-grid">
    <article class="daily-summary-card"><span>🔥</span><div><small>Current streak</small><strong><span id="currentStreakValue"><%= currentStreak || 0 %></span> days</strong><small id="currentStreakStatus"><%= activeToday ? 'Today’s streak is safe.' : 'Save one completed task today to keep it active.' %></small></div></article>
    <article class="daily-summary-card"><span>✓</span><div><small>Today’s progress</small><strong id="taskProgressCount"><%= tasks.filter(task => task.isCompleted).length %> / <%= tasks.length %> complete</strong></div></article>
    <article class="daily-summary-card"><span>✦</span><div><small>Completion</small><strong id="taskProgressPercent"><%= tasks.length ? Math.round(tasks.filter(task => task.isCompleted).length / tasks.length * 100) : 0 %>%</strong></div></article>
    <article class="daily-summary-card daily-score-card"><span>↗</span><div><small>Employability score</small><strong><span id="employabilityScoreValue"><%= employabilityScore %></span>/100</strong></div></article>
  </div>
  <div class="daily-progress-track" role="progressbar" aria-label="Today's task progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= tasks.length ? Math.round(tasks.filter(task => task.isCompleted).length / tasks.length * 100) : 0 %>"><span id="taskProgressFill" style="width:<%= tasks.length ? Math.round(tasks.filter(task => task.isCompleted).length / tasks.length * 100) : 0 %>%"></span></div>
  <section class="daily-task-panel"><form id="dailyTasksForm" action="/student/daily-tasks/save" method="POST"><div class="daily-task-panel-heading"><div><h2>Your focus list</h2><p>Tick the tasks you finished, then save today’s progress.</p></div><div class="daily-panel-actions"><span class="daily-date"><%= new Date().toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata', weekday: 'short', day: 'numeric', month: 'short' }) %></span><button class="daily-save-button" id="dailyTaskSaveButton" type="submit">Save progress</button></div></div>
    <div class="daily-task-list">
      <% if (tasks.length) { %>
        <% tasks.forEach(task => { %>
          <article class="daily-task-row task-item <%= task.isCompleted ? 'done' : '' %>" data-task-row>
            <label class="daily-task-check"><input data-daily-task-checkbox type="checkbox" name="completedTaskIds[]" value="<%= task._id %>" data-task-id="<%= task._id %>" data-saved-checked="<%= task.isCompleted %>" <%= task.isCompleted ? 'checked' : '' %> onchange="stageDailyTask(this)" aria-label="Mark <%= task.title %> complete"><span class="custom-check" aria-hidden="true">✓</span></label>
            <div class="daily-task-copy"><strong class="dashboard-task-title"><%= task.title %></strong><small><%= task.isCompleted ? 'Completed — nice work!' : 'One focused session is enough to make progress.' %></small></div>
            <span class="daily-task-xp"><%= task.isCompleted ? 'Done' : '+10 XP' %></span>
          </article>
        <% }) %>
      <% } else { %>
        <div class="daily-empty"><span>☀</span><h3>Your list is clear for today</h3><p>Generate or refresh your learning roadmap to get focused tasks here.</p><a href="/student/roadmap">Build your roadmap →</a></div>
      <% } %>
    </div>
    <p class="task-update-status" id="taskUpdateStatus" role="status" aria-live="polite">Tick completed tasks, then save your progress.</p></form>
  </section>
</section>
<style>
  .daily-workspace{max-width:1100px;margin:auto}.daily-heading{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:1.3rem}.daily-heading h1{margin:.2rem 0;color:#302749;font-size:clamp(1.6rem,4vw,2.15rem)}.daily-heading>div>p:last-child{color:#786f86;margin:.2rem 0}.daily-summary-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.8rem}.daily-summary-card{display:flex;align-items:center;gap:.8rem;padding:1rem;border:1px solid #e9e2f1;border-radius:13px;background:#fff}.daily-summary-card>span{display:grid;place-items:center;width:40px;height:40px;border-radius:12px;background:#f3effb;color:#7954c8;font-size:1.15rem}.daily-summary-card:first-child>span{background:#fff6e8;color:#bb7d24}.daily-summary-card div{display:grid;gap:.1rem;min-width:0}.daily-summary-card small{color:#8d8499;font-size:.7rem}.daily-summary-card strong{color:#372e49;font-size:.95rem}.daily-progress-track{height:8px;margin:1rem 0 1.25rem;overflow:hidden;border-radius:99px;background:#eeeaf3}.daily-progress-track>span{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,#9e7ad9,#7954c8);transition:width .25s ease}.daily-task-panel{padding:clamp(1rem,3vw,1.5rem);border:1px solid #e9e2f1;border-radius:16px;background:#fff;box-shadow:0 12px 32px #3424500a}.daily-task-panel-heading{display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;margin-bottom:1rem}.daily-task-panel-heading h2{margin:0;color:#352c48;font-size:1.1rem}.daily-task-panel-heading p{margin:.2rem 0 0;color:#8b8298;font-size:.78rem}.daily-panel-actions{display:flex;align-items:center;gap:.55rem;flex-wrap:wrap}.daily-date{white-space:nowrap;padding:.38rem .6rem;border-radius:8px;background:#f7f4fb;color:#7254ab;font-size:.7rem;font-weight:750}.daily-save-button{border:0;border-radius:8px;padding:.55rem .8rem;background:#7954c8;color:#fff;font-size:.76rem;font-weight:800;cursor:pointer}.daily-save-button:disabled{background:#eee9f5;color:#81768e;cursor:default}.daily-task-list{display:grid;gap:.65rem}.daily-task-row{display:flex;align-items:center;gap:.8rem;padding:.85rem;border:1px solid #eee9f4;border-radius:12px;transition:background .2s,border-color .2s}.daily-task-row.done{background:#faf8fd;border-color:#e8e1f1}.daily-task-check{position:relative;display:grid;place-items:center;width:28px;height:28px;flex:0 0 28px;cursor:pointer}.daily-task-check input{position:absolute;width:100%;height:100%;opacity:0;cursor:pointer}.custom-check{display:grid;place-items:center;width:23px;height:23px;border:1.5px solid #d5cde1;border-radius:7px;color:transparent;font-size:.8rem;font-weight:900;transition:all .18s}.daily-task-check input:checked+.custom-check{background:#7954c8;border-color:#7954c8;color:#fff}.daily-task-check input:focus-visible+.custom-check{outline:3px solid #7954c833;outline-offset:2px}.daily-task-copy{display:grid;gap:.22rem;flex:1;min-width:0}.daily-task-copy strong{color:#382f49;font-size:.86rem;line-height:1.45}.daily-task-row.done .daily-task-copy strong{text-decoration:line-through;color:#968da2}.daily-task-copy small{color:#92899e;font-size:.7rem}.daily-task-xp{white-space:nowrap;padding:.28rem .48rem;border-radius:999px;background:#f3effb;color:#7652bb;font-size:.66rem;font-weight:800}.daily-task-row.done .daily-task-xp{background:#edf7f1;color:#418061}.daily-empty{padding:2.5rem 1rem;text-align:center}.daily-empty>span{display:inline-grid;place-items:center;width:44px;height:44px;border-radius:14px;background:#f2edfb;color:#7954c8;font-size:1.3rem}.daily-empty h3{margin:.7rem 0 .2rem;color:#463b58}.daily-empty p{margin:0 0 .75rem;color:#8b8298;font-size:.8rem}.daily-empty a{font-size:.8rem;font-weight:750}@media(max-width:600px){.daily-heading{align-items:flex-start;flex-direction:column}.daily-summary-grid{grid-template-columns:1fr}.daily-summary-card{padding:.75rem}.daily-task-panel-heading{flex-direction:column}.daily-task-row{align-items:flex-start;padding:.75rem}.daily-task-check{margin-top:.1rem}}
</style>
