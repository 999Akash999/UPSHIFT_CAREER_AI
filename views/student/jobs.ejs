<% layout('layouts/dashboardLayout') %>
<main class="jobs-page">
  <header class="jobs-heading">
    <div><p class="jobs-eyebrow">CAREER OPPORTUNITIES</p><h1>Find your next role</h1><p>Explore open positions that match your skills and career goals.</p></div>
    <div class="jobs-score-card"><span>Your employability score</span><strong><%= Number(currentScore || 0) %><small>/100</small></strong></div>
  </header>

  <form class="jobs-filters" action="/student/jobs" method="GET">
    <label>Role or keyword<input type="search" name="role" value="<%= query?.role || '' %>" placeholder="e.g. Backend Engineer"></label>
    <label>Location<input type="search" name="location" value="<%= query?.location || '' %>" placeholder="City or remote"></label>
    <label>Maximum score cutoff<select name="minScore"><option value="">Any cutoff</option><% [40,50,60,70,80,90].forEach((score) => { %><option value="<%= score %>" <%= String(query?.minScore || '') === String(score) ? 'selected' : '' %>><%= score %> and below</option><% }) %></select></label>
    <button class="jobs-button jobs-button-primary" type="submit">Search jobs</button>
    <% if (query?.role || query?.location || query?.minScore) { %><a class="jobs-clear-link" href="/student/jobs">Clear filters</a><% } %>
  </form>

  <div class="jobs-results-heading"><h2>Open positions</h2><span><%= jobs?.length || 0 %> <%= jobs?.length === 1 ? 'role' : 'roles' %></span></div>
  <% if (jobs?.length) { %><section class="jobs-list" aria-label="Open job positions">
    <% jobs.forEach((job) => { const cutoff = Number(job.minEmployabilityScore || 60); const qualifies = Number(currentScore || 0) >= cutoff; %>
      <article class="job-card">
        <div class="job-card-main">
          <div class="job-company-mark" aria-hidden="true"><%= (job.company?.name || 'U').trim().charAt(0).toUpperCase() %></div>
          <div class="job-card-copy">
            <div class="job-company-row"><strong><%= job.company?.name || 'Partner company' %></strong><span class="job-dot">·</span><span><%= job.location || 'Location not specified' %></span></div>
            <h3><a href="/student/jobs/<%= job._id %>"><%= job.title %></a></h3>
            <p class="job-card-description"><%= job.description || 'Explore this role and review the requirements.' %></p>
            <div class="job-tags"><span><%= job.type || 'Engineering role' %></span><% (job.requiredSkills || []).slice(0, 6).forEach((skill) => { %><span><%= skill %></span><% }) %><% if ((job.requiredSkills || []).length > 6) { %><span>+<%= job.requiredSkills.length - 6 %> more</span><% } %></div>
          </div>
        </div>
        <aside class="job-card-action"><div class="job-cutoff <%= qualifies ? 'is-qualified' : 'needs-growth' %>"><span>Employability cutoff</span><strong><%= cutoff %><small>/100</small></strong><em><%= qualifies ? 'You meet this cutoff' : `${Math.max(0, cutoff - Number(currentScore || 0))} points to go` %></em></div><a class="jobs-button jobs-button-primary" href="/student/jobs/<%= job._id %>">View role & apply <span aria-hidden="true">→</span></a></aside>
      </article>
    <% }) %>
  </section><% } else { %><section class="jobs-empty"><span aria-hidden="true">⌕</span><h2>No matching roles found</h2><p>Try removing a filter or check again as recruiters add new openings.</p><a class="jobs-button jobs-button-secondary" href="/student/jobs">Show all jobs</a></section><% } %>
</main>
