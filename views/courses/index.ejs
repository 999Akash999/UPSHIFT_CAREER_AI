<% layout('layouts/dashboardLayout') %>
<section class="course-catalog">
  <header class="course-catalog-heading">
    <div><p class="eyebrow">LEARN WITH A CLEAR PATH</p><h1>Courses & certifications</h1><p>Build practical skills with focused lessons, exercises, and portfolio work.</p></div>
  </header>
  <div class="course-catalog-grid">
    <% if (typeof courses !== 'undefined' && courses.length > 0) { %>
      <% courses.forEach((course) => { %>
        <article class="course-catalog-card">
          <div class="course-catalog-banner"><span><%= course.category %></span><small><%= course.level %></small><div class="course-catalog-symbol" aria-hidden="true">✦</div></div>
          <div class="course-catalog-body"><h2><%= course.title %></h2><p><%= course.description ? course.description.substring(0, 150) + (course.description.length > 150 ? '…' : '') : 'A practical curriculum to help you build job-ready skills.' %></p>
            <% if (course.targetSkillGaps?.length) { %><div class="course-skill-tags"><% course.targetSkillGaps.slice(0, 3).forEach((gap) => { %><span><%= gap %></span><% }) %></div><% } %>
          </div>
          <footer class="course-catalog-footer"><div><strong>₹<%= course.discountPrice || course.price %></strong><% if (course.discountPrice && course.discountPrice < course.price) { %><del>₹<%= course.price %></del><% } %></div><a class="button-primary" href="/courses/<%= course.slug %>">Explore course <span aria-hidden="true">→</span></a></footer>
        </article>
      <% }) %>
    <% } else { %>
      <div class="course-empty"><span aria-hidden="true">🎓</span><h2>Courses are on the way</h2><p>New learning paths will appear here as they are published.</p></div>
    <% } %>
  </div>
</section>
