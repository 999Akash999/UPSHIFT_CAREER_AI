<% layout('layouts/dashboardLayout') %>
<section class="course-detail">
  <a class="course-back-link" href="/courses">← All courses</a>
  <div class="course-detail-grid">
    <main>
      <header class="course-detail-hero"><p class="eyebrow"><%= course.category %> · <%= course.level %></p><h1><%= course.title %></h1><p><%= course.description %></p><div class="course-detail-meta"><span>◷ Self paced</span><span>▤ <%= (course.modules || []).length %> modules</span><span>✓ Practical exercises</span></div></header>
      <section class="course-syllabus"><div class="course-section-heading"><div><p class="eyebrow">YOUR LEARNING PATH</p><h2>Course curriculum</h2></div><span><%= (course.modules || []).reduce((count, mod) => count + (mod.lessons || []).length, 0) %> lessons</span></div>
        <% if (course.modules?.length) { %><div class="course-module-list"><% course.modules.forEach((mod, idx) => { %><details class="course-module" <%= idx === 0 ? 'open' : '' %>><summary><span><b>Module <%= String(idx + 1).padStart(2, '0') %></b><strong><%= mod.title %></strong></span><small><%= (mod.lessons || []).length %> lessons</small></summary><% if (mod.description) { %><p class="course-module-description"><%= mod.description %></p><% } %><div class="course-lesson-list"><% (mod.lessons || []).forEach((lesson, lessonIdx) => { %><details class="course-lesson-preview"><summary><span class="course-lesson-number"><%= String(lessonIdx + 1).padStart(2, '0') %></span><strong><%= lesson.title %></strong><small><%= lesson.durationMinutes %> min · View details</small></summary><div class="course-lesson-preview-content"><% if (lesson.content) { %><p><%= lesson.content %></p><% } %><% if (lesson.practiceTask) { %><div class="course-practice"><strong>Practice task</strong><p><%= lesson.practiceTask %></p></div><% } %><% if (lesson.codeExample) { %><pre><code><%= lesson.codeExample %></code></pre><% } %></div></details><% }) %></div></details><% }) %></div><% } else { %><p class="course-curriculum-empty">Course modules will be added soon.</p><% } %>
      </section>
    </main>
    <aside class="course-enroll-card"><div class="course-enroll-icon" aria-hidden="true">✦</div><p class="eyebrow">START LEARNING</p><h2>Build skills that move you forward.</h2><div class="course-price">₹<%= course.discountPrice || course.price %><% if (course.discountPrice && course.discountPrice < course.price) { %><del>₹<%= course.price %></del><% } %></div><a class="button-primary" href="/courses/<%= course.slug %>/checkout">Continue to checkout <span aria-hidden="true">→</span></a><ul><li>Structured lessons and practice</li><li>Learn at your own pace</li><li>Project-focused curriculum</li></ul></aside>
  </div>
</section>
