<% layout('layouts/boilerplate') %>
<section class="public-info-page">
  <header class="public-info-hero"><a class="public-info-back" href="/">← UPSHIFT home</a><p class="eyebrow">HELP CENTER</p><h1>Find your next step.</h1><p>Quick links for common tasks. If something is not working, contact support with the page name and what happened.</p></header>
  <div class="public-info-sections public-help-grid">
    <article><span class="public-info-icon">▣</span><h2>Browse courses</h2><p>Explore published courses and open a course to see its lessons and enrollment options.</p><a href="/courses">Go to courses →</a></article>
    <article><span class="public-info-icon">⌂</span><h2>Account and profile</h2><p>Sign in to update your profile, manage your learning workspace, and review saved activity.</p><a href="/login">Sign in →</a></article>
    <article><span class="public-info-icon">↗</span><h2>Career workspace</h2><p>Roadmaps, daily tasks, projects, and interview practice are available from your student dashboard.</p><a href="/signup">Create an account →</a></article>
    <article><span class="public-info-icon">✉</span><h2>Technical support</h2><p>Describe the issue and include the page URL. Never send passwords, OAuth secrets, or verification codes.</p><a href="/contact">Contact support →</a></article>
  </div>
  <section class="public-contact-card public-help-query" aria-labelledby="helpQueryHeading">
    <p class="public-info-eyebrow">NEED MORE HELP?</p><h2 id="helpQueryHeading">Send the UPSHIFT team a query</h2>
    <p>Tell us what you need. We’ll reply to the email address you provide.</p>
    <%- include('../partials/contact-query-form') %>
  </section>
</section>
