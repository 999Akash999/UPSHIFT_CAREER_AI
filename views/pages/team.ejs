<% layout('layouts/boilerplate') %>
<section class="public-info-page public-team-page">
  <header class="public-info-hero"><a class="public-info-back" href="/">← UPSHIFT home</a><p class="eyebrow">PEOPLE BEHIND THE PRODUCT</p><h1>Meet the team.</h1><p>Four teammates working to make career preparation more structured, approachable, and connected to real work.</p></header>
  <section class="public-founder-feature" aria-label="Founder profile">
    <div class="public-founder-portrait">
      <div class="public-team-photo-frame"><div class="public-team-photo-placeholder" aria-hidden="true">ADD FOUNDER PHOTO</div><img src="/images/team/akash.jpeg" alt="Akash Gangwar" loading="lazy" onload="this.parentElement.classList.add('has-photo')" onerror="this.remove()"></div>
      <h2>Akash Gangwar</h2><p class="public-team-role public-founder-title">Founder <span aria-hidden="true">·</span> CEO</p>
    </div>
    <div class="public-founder-bio"><p class="public-founder-kicker"><span aria-hidden="true">✦</span> UPSHIFT LEADERSHIP · FOUNDER &amp; CEO</p><h2>Akash Gangwar</h2><h3>Building a clearer path from learning to career.</h3><p>Akash founded UPSHIFT to bring learning, projects, and career preparation together in one practical workspace for student engineers.</p><p>As CEO, he leads the vision and direction of UPSHIFT, with a focus on helping learners understand what to work on next and show the progress they make along the way.</p></div>
  </section>
  <section class="public-team-section" aria-labelledby="team-members-heading">
    <div class="public-team-section-heading"><p class="eyebrow">THE TEAM</p><h2 id="team-members-heading">The people building UPSHIFT</h2></div>
    <div class="public-team-grid" aria-label="Other UPSHIFT team members">
      <article class="public-team-card"><div class="public-team-photo-frame"><div class="public-team-photo-placeholder" aria-hidden="true">ADD PHOTO</div><img src="/images/team/devansh-mishra.jpg" alt="Devansh Mishra" loading="lazy" onload="this.parentElement.classList.add('has-photo')" onerror="this.remove()"></div><div class="public-team-copy"><h3>Devansh Mishra</h3><p class="public-team-role">AI/ML Lead</p><p class="public-team-bio">Leading the AI and machine learning work behind more personalized learning experiences.</p></div></article>
      <article class="public-team-card"><div class="public-team-photo-frame"><div class="public-team-photo-placeholder" aria-hidden="true">ADD PHOTO</div><img src="/images/team/anurag-verma.jpg" alt="Anurag Verma" loading="lazy" onload="this.parentElement.classList.add('has-photo')" onerror="this.remove()"></div><div class="public-team-copy"><h3>Anurag Verma</h3><p class="public-team-role">Head of Growth &amp; Partnerships</p><p class="public-team-bio">Growing the UPSHIFT community and building partnerships that create opportunities for learners.</p></div></article>
      <article class="public-team-card"><div class="public-team-photo-frame"><div class="public-team-photo-placeholder" aria-hidden="true">ADD PHOTO</div><img src="/images/team/atul.jpeg" alt="Atul Dev" loading="lazy" onload="this.parentElement.classList.add('has-photo')" onerror="this.remove()"></div><div class="public-team-copy"><h3>Atul Dev</h3><p class="public-team-role">Head of Career Development</p><p class="public-team-bio">Shaping practical career development experiences to help students become job-ready.</p></div></article>
    </div>
  </section>
  <div class="public-info-cta"><h2>Want to work with us?</h2><p>We welcome mentors, educators, and partners who want to help students move forward.</p><a href="/contact">Get in touch →</a></div>
</section>
