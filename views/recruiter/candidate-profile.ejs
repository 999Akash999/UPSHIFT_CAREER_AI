<% layout('layouts/dashboardLayout') %>

<main style="max-width:950px;margin:0 auto;">
  <a href="/recruiter/candidates" style="color:#2563eb;">← Candidate search</a>
  <section style="margin-top:1rem;padding:1.5rem;background:#fff;border:1px solid #e2e8f0;border-radius:12px;">
    <h1 style="margin:0;color:#0f172a;"><%= candidate.user ? candidate.user.name : 'Candidate' %></h1>
    <p style="color:#64748b;"><%= candidate.user ? candidate.user.email : '' %></p>
    <p><strong>Target role:</strong> <%= candidate.targetRole || 'Not specified' %></p>
    <p><strong>Employability score:</strong> <%= snapshot ? snapshot.overallScore : 'Not assessed' %></p>
    <p><strong>Education:</strong> <%= candidate.academicDetails.degree || 'Not provided' %> · <%= candidate.academicDetails.college || 'Not provided' %></p>
    <p><strong>Skills:</strong> <%= (candidate.skills || []).join(', ') || 'Not provided' %></p>
    <% if (candidate.bio) { %><p><%= candidate.bio %></p><% } %>
  </section>
  <h2 style="color:#0f172a;">Projects</h2>
  <% if (projects.length) { %>
    <% projects.forEach(project => { %>
      <article style="margin:.75rem 0;padding:1rem;background:#fff;border:1px solid #e2e8f0;border-radius:10px;">
        <h3 style="margin:.2rem 0;"><%= project.title %></h3><p><%= project.description %></p>
        <p style="color:#64748b;"><%= (project.techStack || []).join(', ') %></p>
      </article>
    <% }) %>
  <% } else { %><p>No projects provided.</p><% } %>
</main>
