    <div>
      <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3); padding: 0.25rem 0.75rem; border-radius: 20px; font-size: 0.75rem; font-weight: 700; color: #34d399; margin-bottom: 0.75rem;">
        <span style="width: 8px; height: 8px; background: #10b981; border-radius: 50%; box-shadow: 0 0 6px #10b981;"></span> SYSTEM LEVEL 0 &bull; ROOT CONSOLE
      </div>
      <h2 style="font-size: 1.85rem; font-weight: 800; margin: 0 0 0.35rem; letter-spacing: -0.02em;">
