<% layout('layouts/boilerplate') %>

<section class="auth-page-shell">
  <div class="auth-card auth-card-compact auth-confirm-card">
    <div class="auth-mark" aria-hidden="true">✉</div>
    <p class="auth-eyebrow">ONE QUICK STEP</p>
    <h1>Verify your email</h1>
    <p class="auth-intro">We sent a verification link to your email. Confirming it helps recruiters contact you about interviews and opportunities.</p>
    <div class="auth-info-panel">
      <strong>What to do next</strong>
      <ol>
        <li>Open the message in your inbox and follow its link.</li>
        <li>Check spam or promotions if it is missing.</li>
        <li>The link stays active for 24 hours.</li>
      </ol>
    </div>
    <div class="auth-confirm-actions">
      <a class="auth-submit auth-submit-link" href="/login">Continue to sign in <span aria-hidden="true">→</span></a>
      <form action="/auth/resend-verification" method="POST">
        <button class="auth-resend" type="submit">Resend verification email</button>
      </form>
    </div>
  </div>
</section>
