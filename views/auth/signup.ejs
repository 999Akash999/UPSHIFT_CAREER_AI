<% layout('layouts/boilerplate') %>
<section class="auth-page-shell">
  <div class="auth-card auth-card-signup">
    <header class="auth-card-header"><a class="auth-mark auth-logo-link" href="/" aria-label="UPSHIFT home"><img src="/images/logos/m1.png" alt=""></a><p class="auth-eyebrow">START YOUR NEXT CHAPTER</p><h1>Create your account</h1><p>Build skills, track your progress, and prepare for your next opportunity.</p></header>
    <div class="auth-social-grid" aria-label="Sign up with a provider">
      <a class="auth-provider auth-provider-google" href="/auth/google"><span aria-hidden="true">G</span>Google</a>
      <a class="auth-provider auth-provider-github" href="/auth/github"><span aria-hidden="true">⌘</span>GitHub</a>
      <a class="auth-provider auth-provider-linkedin" href="/auth/linkedin"><span aria-hidden="true">in</span>LinkedIn</a>
      <a class="auth-provider auth-provider-apple" href="/auth/apple"><span aria-hidden="true">●</span>Apple</a>
    </div>
    <div class="auth-divider"><span>or create an account with email</span></div>
    <form action="/signup" method="POST" class="auth-form">
      <label for="signupName">Full name</label><input id="signupName" type="text" name="name" required maxlength="100" autocomplete="name" placeholder="Your full name">
      <label for="signupEmail">Email address</label><input id="signupEmail" type="email" name="email" required autocomplete="email" placeholder="you@example.com">
      <label for="signupPassword">Password <span class="auth-label-hint">8 characters minimum</span></label><input id="signupPassword" type="password" name="password" required minlength="8" autocomplete="new-password" placeholder="Create a password">
      <label for="signupRole">I’m joining as</label>
      <select id="signupRole" name="role">
        <option value="student">Student — learning and career growth</option>
        <option value="recruiter">Recruiter — hiring and talent search</option>
        <option value="mentor">Mentor — sessions and learner guidance</option>
        <option value="alumni">Alumni — community and referrals</option>
      </select>
      <button class="auth-submit" type="submit">Create account <span aria-hidden="true">→</span></button>
    </form>
    <p class="auth-switch">Already have an account? <a href="/login">Sign in</a></p>
  </div>
</section>
