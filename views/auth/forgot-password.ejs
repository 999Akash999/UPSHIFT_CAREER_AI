<% layout('layouts/boilerplate') %>
<section class="auth-page-shell"><div class="auth-card auth-card-compact">
  <header class="auth-card-header"><span class="auth-symbol" aria-hidden="true">↺</span><p class="auth-eyebrow">ACCOUNT RECOVERY</p><h1>Reset your password</h1><p>Enter the email address linked to your account. We’ll send a secure reset link if it matches.</p></header>
  <form action="/forgot-password" method="POST" class="auth-form"><label for="recoveryEmail">Email address</label><input id="recoveryEmail" type="email" name="email" required autocomplete="email" placeholder="you@example.com"><button class="auth-submit" type="submit">Send reset link <span aria-hidden="true">→</span></button></form>
  <p class="auth-switch"><a href="/login">← Back to sign in</a></p>
</div></section>
