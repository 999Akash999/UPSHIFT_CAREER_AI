<% layout('layouts/boilerplate') %>
<section class="auth-page-shell">
  <div class="auth-card">
    <header class="auth-card-header"><a class="auth-mark auth-logo-link" href="/" aria-label="UPSHIFT home"><img src="/images/logos/m1.png" alt=""></a><p class="auth-eyebrow">YOUR CAREER WORKSPACE</p><h1>Welcome back</h1><p>Sign in to continue your learning and career journey.</p></header>
    <div class="auth-social-grid" aria-label="Sign in with a provider">
      <a class="auth-provider auth-provider-google" href="/auth/google"><span aria-hidden="true">G</span>Continue with Google</a>
      <a class="auth-provider auth-provider-github" href="/auth/github"><span aria-hidden="true">⌘</span>Continue with GitHub</a>
      <a class="auth-provider auth-provider-linkedin" href="/auth/linkedin"><span aria-hidden="true">in</span>Continue with LinkedIn</a>
      <a class="auth-provider auth-provider-apple" href="/auth/apple"><span aria-hidden="true">●</span>Continue with Apple</a>
    </div>
    <div class="auth-divider"><span>or sign in with email</span></div>
    <form action="/login" method="POST" class="auth-form">
      <label for="loginEmail">Email address</label><input id="loginEmail" type="email" name="email" required autocomplete="email" placeholder="you@example.com">
      <div class="auth-password-label"><label for="loginPassword">Password</label><a href="/forgot-password">Forgot password?</a></div><input id="loginPassword" type="password" name="password" required autocomplete="current-password" placeholder="Enter your password">
      <button class="auth-submit" type="submit">Sign in <span aria-hidden="true">→</span></button>
    </form>
    <p class="auth-switch">New to UPSHIFT? <a href="/signup">Create an account</a></p>
  </div>
</section>
