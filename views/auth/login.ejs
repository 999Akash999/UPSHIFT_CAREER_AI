<% layout('layouts/boilerplate') %>

<div style="min-height: calc(100vh - 180px); display: flex; align-items: center; justify-content: center; padding: 3rem 1.5rem;">
  <div style="background: #0f172a; border: 1px solid #1e3a5f; width: 100%; max-width: 460px; padding: 2.5rem; border-radius: 16px; box-shadow: 0 10px 40px rgba(0, 0, 0, 0.45);">
    
    <div style="text-align: center; margin-bottom: 2rem;">
      <div style="width: 44px; height: 44px; background: #2563eb; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; color: #ffffff; font-weight: 800; font-size: 1.3rem; margin-bottom: 0.75rem; box-shadow: 0 0 20px rgba(37, 99, 235, 0.4);">
        U
      </div>
      <h2 style="font-size: 1.75rem; font-weight: 800; color: #ffffff; margin-bottom: 0.35rem; letter-spacing: -0.02em;">Welcome Back</h2>
      <p style="color: #94a3b8; font-size: 0.9rem; margin: 0;">Sign in to your UPSHIFT CAREER terminal</p>
    </div>

    <!-- 4-Way Social Authentication Grid -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.5rem;">
      
      <!-- Google -->
      <a href="/auth/google" style="display: flex; align-items: center; justify-content: center; gap: 0.6rem; background: #ffffff; color: #0f172a; padding: 0.7rem; border-radius: 8px; font-weight: 700; font-size: 0.85rem; text-decoration: none; border: 1px solid #ffffff; transition: transform 0.2s;">
        <svg width="18" height="18" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
        </svg>
        Google
      </a>

      <!-- GitHub -->
      <a href="/auth/github" style="display: flex; align-items: center; justify-content: center; gap: 0.6rem; background: #1e293b; color: #ffffff; padding: 0.7rem; border-radius: 8px; font-weight: 700; font-size: 0.85rem; text-decoration: none; border: 1px solid #334155; transition: transform 0.2s;">
        <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        GitHub
      </a>

      <!-- LinkedIn -->
      <a href="/auth/linkedin" style="display: flex; align-items: center; justify-content: center; gap: 0.6rem; background: #0a66c2; color: #ffffff; padding: 0.7rem; border-radius: 8px; font-weight: 700; font-size: 0.85rem; text-decoration: none; border: 1px solid #0a66c2; transition: transform 0.2s;">
        <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
          <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
        </svg>
        LinkedIn
      </a>

      <!-- Apple -->
      <a href="/auth/apple" style="display: flex; align-items: center; justify-content: center; gap: 0.6rem; background: #000000; color: #ffffff; padding: 0.7rem; border-radius: 8px; font-weight: 700; font-size: 0.85rem; text-decoration: none; border: 1px solid #334155; transition: transform 0.2s;">
        <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
          <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.61-.75 1.04-1.8 0.92-2.85-.9.04-2 .6-2.65 1.34-.56.63-1.06 1.68-.92 2.7.99.08 2.03-.46 2.65-1.19z"/>
        </svg>
        Apple
      </a>

    </div>

    <!-- Divider -->
    <div style="display: flex; align-items: center; gap: 1rem; margin: 1.5rem 0;">
      <div style="flex-grow: 1; height: 1px; background: #1e3a5f;"></div>
      <span style="color: #64748b; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">Or with Email</span>
      <div style="flex-grow: 1; height: 1px; background: #1e3a5f;"></div>
    </div>

    <!-- Local Authentication Form -->
    <form action="/login" method="POST">
      <div style="margin-bottom: 1.25rem;">
        <label style="display: block; font-size: 0.85rem; font-weight: 600; color: #cbd5e1; margin-bottom: 0.4rem;">Institutional or Work Email</label>
        <input type="email" name="email" required placeholder="alex@engineering.edu" style="width: 100%; background: #070d19; border: 1px solid #1e3a5f; color: #ffffff; padding: 0.75rem 1rem; border-radius: 8px; outline: none; font-size: 0.95rem;">
      </div>

      <div style="margin-bottom: 1.5rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
          <label style="font-size: 0.85rem; font-weight: 600; color: #cbd5e1;">Master Password</label>
          <a href="/forgot-password" style="font-size: 0.75rem; color: #60a5fa; font-weight: 600; text-decoration: none;">Forgot password?</a>
        </div>
        <input type="password" name="password" required placeholder="••••••••••••" style="width: 100%; background: #070d19; border: 1px solid #1e3a5f; color: #ffffff; padding: 0.75rem 1rem; border-radius: 8px; outline: none; font-size: 0.95rem;">
      </div>

      <button type="submit" style="width: 100%; background: #2563eb; color: #ffffff; border: none; padding: 0.85rem; border-radius: 8px; font-weight: 700; font-size: 1rem; cursor: pointer; box-shadow: 0 4px 14px rgba(37, 99, 235, 0.4);">
        Sign In to Workspace →
      </button>
    </form>

    <div style="text-align: center; margin-top: 1.5rem; font-size: 0.85rem; color: #94a3b8;">
      Don't have an active profile? <a href="/signup" style="color: #60a5fa; font-weight: 700; text-decoration: none;">Create an account</a>
    </div>

  </div>
</div>
